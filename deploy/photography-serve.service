# Installed at /etc/systemd/system/photography-serve.service on the box that
# hosts randyliang.net. This file is the source of truth — install changes
# with the steps in docs/deployment.md ("Installing or updating the units").
#
# Serves the deployed site/release plus the password-gated /private area
# (tools/serve). It does not build anything: `pnpm deploy` builds a release
# beside the live one and switches to it, restarting this unit only when the
# server's own code changed. Secrets come from the repository's .env (mode
# 600), which the server reads itself — none are written here.

[Unit]
Description=randyliang.net web server (tools/serve on :4322)
After=network.target
# Restart=always below, but never a tight loop: more than 10 starts in 5
# minutes and systemd stops trying and marks the unit failed.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=randy
Group=randy
WorkingDirectory=/home/randy/Development/photography
# Node by absolute path, not through pnpm: SIGTERM reaches the server
# itself, which finishes in-flight requests before exiting (cli.ts).
ExecStart=/home/randy/.local/nodejs/bin/node tools/serve/src/cli.ts
Restart=always
RestartSec=2
TimeoutStopSec=15
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
