# Installed at /etc/systemd/system/cloudflared-tunnel.service on the box
# that hosts randyliang.net. Source of truth — see docs/deployment.md
# ("Installing or updating the units").
#
# Wants=, not Requires=: with Requires=, every restart of the web server
# (every deploy) also stopped and restarted the tunnel, dropping all four
# Cloudflare connections — the likely cause of the 2026-10-25 502. Now the
# tunnel stays connected through a server restart; a request in that
# sub-second gap gets cloudflared's own 502, not a torn-down tunnel.
#
# --no-autoupdate: cloudflared otherwise replaces itself and restarts on
# its own schedule (it did on Oct 15, 20 and 21). Update it deliberately:
# see docs/deployment.md ("Updating cloudflared").
#
# Needs cloudflared at ~/.local/bin/cloudflared and the tunnel credentials
# in ~/.cloudflared/ (a secret, never committed); deploy/cloudflared-config.yml
# has everything else.

[Unit]
Description=Cloudflare Tunnel for randyliang.net
Wants=network-online.target photography-serve.service
After=network-online.target photography-serve.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
User=randy
Group=randy
Environment=HOME=/home/randy
ExecStart=/home/randy/.local/bin/cloudflared tunnel --no-autoupdate --config /home/randy/.cloudflared/config.yml run
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
