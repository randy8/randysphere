---
import Photo from './Photo.astro';
import { formatCameraLine } from './camera.ts';
import { site } from '../config.ts';
import type { View } from './archive.ts';

interface Props {
  view: View;
  /**
   * The next view in the archive's own listed order (see allTags in
   * archive.ts, the same order /photography/archive/ shows) — null for the
   * last one, and null on views that aren't part of that sequence (Selected
   * Work, film stock). Reaching the last photo becomes a real chapter
   * break into this view rather than a dead end. See CHANGELOG.md.
   */
  next?: { tag: string; title: string; date: string | null; count: number } | null;
  /**
   * A tag or film-stock view's opening panel is real information (its
   * title, its date, its film stock) worth a beat before the photographs
   * start. Selected Work has none of that — no date, no shared roll, just
   * "Selected Work" restated — so for it this was a title screen with no
   * hint of how to move past it, not a chapter opener. False skips it
   * entirely: the stack's first child is the first photograph, and landing
   * there is just the ordinary "no #photo-<id> hash" default (see
   * browse.ts), not a special case.
   */
  intro?: boolean;
  /**
   * Set (to the corner mark's own label) only for a page whose "home"
   * corner isn't the site's front door but a contact-sheet grid one scroll
   * away on that same page — /photography/saved/ ("Saved") and
   * /photography/share/ ("Back") today, see saved-view.ts/share-view.ts.
   * The corner control becomes a plain in-page "back to grid" button
   * rather than a real navigation. Every other page's browse-home, a real
   * link to "/", is untouched.
   */
  exitToGrid?: string | false;
  /**
   * Passed straight through to each photograph's own Photo.astro maxWidth
   * (see there) — unset everywhere except /photography/saved/ and
   * /photography/share/, which each render every photo in the archive
   * into this stack (most of them destined to be pruned away client-side
   * before a visitor ever sees them, see saved-view.ts/share-view.ts) and
   * so pay for the full 2560-wide tier — deliberately kept for every other
   * page's real full-size reading view (see CHANGELOG.md, 2026-08-19) —
   * on hundreds of photographs that were never going to use it.
   */
  photoMaxWidth?: number;
}

const { view, next = null, intro = true, exitToGrid = false, photoMaxWidth } = Astro.props;
---

{
  /* Browse mode has no masthead, no nav — deliberately, it's meant to be
     read start to end without chrome competing with the photograph. There
     is no grid to fall back to any more either (except on /saved/, which
     has its own contact-sheet grid on this same page — see exitToGrid
     above), so these one or two quiet corner marks are the entire chrome
     browse mode has. */
}
{
  exitToGrid ? (
    <button type="button" class="browse-home" data-exit-grid>
      {exitToGrid}
    </button>
  ) : (
    <a class="browse-home" href="/" aria-label={`${site.title} — Home`}>
      {site.title}
    </a>
  )
}
{
  /* Opposite corner from browse-home, same treatment — hidden until a
     first photograph is actually saved (see saved.ts's syncSavedUI, which
     every [data-saved-link] on the page, this one included, defers to).
     Skipped entirely on /saved/ itself: the other corner already reads
     "Saved" there, a second one pointing at the same page would be noise,
     not a second destination. */
  !exitToGrid && (
    <a href="/photography/saved/" class="browse-saved-link" data-saved-link>
      Saved <span data-saved-count>0</span>
    </a>
  )
}
<div class="browse" data-browse role="region" aria-label="Photo browser">
  <div class="browse-stack" data-browse-stack>
    {
      intro && (
        <div class="browse-intro">
          <p class="browse-intro-count" aria-hidden="true">
            {String(view.photos.length).padStart(2, '0')}
          </p>
          {view.date && <p class="eyebrow">{view.date}</p>}
          <h2>{view.title}</h2>
          <p class="browse-intro-meta">
            {
              view.roll?.filmStock && (
                <span class="film-stock">
                  <a href={`/photography/film/${view.roll.filmStock}/`}>{view.roll.filmStock}</a>
                </span>
              )
            }
            <span>
              {view.photos.length} photograph{view.photos.length === 1 ? '' : 's'}
            </span>
          </p>
          <p class="browse-intro-cue" aria-hidden="true">
            →
          </p>
        </div>
      )
    }
    {
      view.photos.map((entry, index) => (
        <figure class="browse-item" id={`photo-${entry.photo.sourceId}`} data-photo-id={entry.photo.sourceId}>
          <div class="browse-item-frame">
            <Photo
              entry={entry}
              sizes="100vw"
              linked={false}
              priority={index === 0}
              maxWidth={photoMaxWidth}
            />
            <span class="browse-item-nav browse-item-nav-prev" data-nav="prev" aria-hidden="true" />
            <span class="browse-item-nav browse-item-nav-next" data-nav="next" aria-hidden="true" />
          </div>
          {
            // The intro panel's film stock is a single value for the whole
            // view, which only means something when every photo shares one
            // roll (view.roll !== null). A view that spans rolls — Selected
            // Work, hand-picked across trips — has no single answer up
            // there, but each photo still reliably knows its own: a roll
            // (one directory under originals/) is never a mix of stocks, so
            // entry.roll.filmStock is exactly as trustworthy per photo as
            // the intro panel's value is for a single-roll view.
            view.roll === null && entry.roll.filmStock && (
              <p class="browse-item-meta">
                <a href={`/photography/film/${entry.roll.filmStock}/`}>{entry.roll.filmStock}</a>
              </p>
            )
          }
          {entry.caption && <figcaption>{entry.caption}</figcaption>}
          {formatCameraLine(entry) && <p class="browse-item-meta">{formatCameraLine(entry)}</p>}
          {
            /* Descriptive lines above are about the photograph; this one is
               about the visitor's own relationship to it, so it comes last
               — a quiet line of text, not a floating button, the same
               restraint as everything else down here. Server-rendered
               unsaved (the server can't know localStorage); browse.ts
               reconciles the real state on load. */
          }
          <button type="button" class="browse-save" data-save aria-pressed="false">
            <span data-save-icon aria-hidden="true">+</span> <span data-save-label>Save</span>
          </button>
          <p class="browse-save-hint" data-save-hint hidden>
            Save photographs to revisit later. Stored only in this browser.
          </p>
        </figure>
      ))
    }
    {
      /* The chapter closer mirrors the opener above — same numeral/eyebrow/
         title register — but as one real link, not a dead end at the last
         photograph. Every other way of moving through this album (arrow
         keys, the click zones on each photo) loops back on itself rather
         than ever leaving for a new page — see browse.ts's advance() — so
         this panel, reached only by scrolling (or tabbing) past the last
         photo, is the one deliberate way out to what's next. */
      next && (
        <a class="browse-outro" href={`/photography/${next.tag}/`} data-browse-outro>
          <p class="browse-intro-count" aria-hidden="true">
            {String(next.count).padStart(2, '0')}
          </p>
          <p class="eyebrow">Next</p>
          <h2>{next.title}</h2>
          <p class="browse-intro-meta">
            {next.date && <span>{next.date}</span>}
            <span>
              {next.count} photograph{next.count === 1 ? '' : 's'}
            </span>
          </p>
          <p class="browse-intro-cue" aria-hidden="true">→</p>
        </a>
      )
    }
  </div>
</div>
