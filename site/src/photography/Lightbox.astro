---
import type { ArchivePhoto } from './archive.ts';
import { LIGHTBOX_SIZES, lightboxJson, lightboxPhoto } from './lightbox-data.ts';

interface Props {
  photos: readonly ArchivePhoto[];
  /**
   * Caps every photograph's srcset at this width (see Photo.astro's own
   * maxWidth) — unset everywhere except /exposures/saved/ and
   * /exposures/share/, which carry every public photograph's data for
   * client-side pruning and so skip the 2560-wide tier the real full-size
   * viewer on every other page keeps.
   */
  photoMaxWidth?: number;
}

const { photos, photoMaxWidth } = Astro.props;
const data = lightboxJson(photos.map((entry) => lightboxPhoto(entry, photoMaxWidth)));
---

{
  /*
    A standard lightbox: hidden until a grid tile is clicked (lightbox.ts),
    then one photograph at a time over the grid. Each photograph's markup
    already exists once, as its grid tile; what the lightbox needs beyond
    that (the full-size srcsets, film stock, caption, camera line) travels
    as data in the JSON script below, and lightbox.ts pours it into three
    reusable slots — the photograph on screen and the two either side of
    it, which swipe.ts slides in during a drag and which are therefore
    always already loaded. See docs/decisions.md, 2026-10-25.
  */
}
<div class="lightbox" data-lightbox hidden>
  <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close">
    <span aria-hidden="true">&times;</span>
  </button>
  <p class="lightbox-position" data-lightbox-position aria-hidden="true"></p>
  <button
    type="button"
    class="lightbox-nav lightbox-nav-prev"
    data-nav="prev"
    aria-label="Previous photograph"
  >
    <span aria-hidden="true">&#8249;</span>
  </button>
  <button
    type="button"
    class="lightbox-nav lightbox-nav-next"
    data-nav="next"
    aria-label="Next photograph"
  >
    <span aria-hidden="true">&#8250;</span>
  </button>
  <div class="lightbox-stage" data-lightbox-stage>
    {
      [0, 1, 2].map(() => (
        <figure class="lightbox-item">
          <div class="lightbox-frame">
            <picture class="photo">
              <source type="image/avif" sizes={LIGHTBOX_SIZES} />
              <source type="image/webp" sizes={LIGHTBOX_SIZES} />
              <img alt="" loading="eager" decoding="async" />
            </picture>
          </div>
          <p class="lightbox-item-meta" data-slot-film hidden>
            <a></a>
          </p>
          <figcaption data-slot-caption hidden></figcaption>
          <p class="lightbox-item-meta" data-slot-camera hidden></p>
          <button type="button" class="lightbox-save" data-save aria-pressed="false">
            <span data-save-icon aria-hidden="true">
              +
            </span>{' '}
            <span data-save-label>Save</span>
          </button>
          <p class="lightbox-save-hint" data-save-hint hidden>
            Save photographs to revisit later. Stored only in this browser.
          </p>
        </figure>
      ))
    }
  </div>
  <script is:inline type="application/json" data-lightbox-photos set:html={data} />
</div>

{
  /* Pinch-to-zoom, self-contained (see zoom.ts) — every page that renders
     <Lightbox> gets it for free with no per-page wiring. */
}
<script>
  import { initZoom } from './zoom.ts';

  const root = document.querySelector<HTMLElement>('[data-lightbox]');
  if (root !== null) initZoom(root);
</script>
