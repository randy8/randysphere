---
/**
 * Understated text navigation, specific to the photography collection —
 * not shared with any other collection, and not part of Base.astro, which
 * stays collection-agnostic. Hidden in browse/scroll mode along with the
 * rest of the page chrome (see body.is-browsing in base.css).
 */
interface Props {
  current: 'selected' | 'archive' | 'about' | 'saved';
}

const { current } = Astro.props;

// No separate "Photography"/home link — Selected Work is the collection's
// entry point (collections.ts's href points straight here), so it already
// fills that role without a second, redundant nav item pointing at the
// same destination twice under two different labels.
//
// Archive deliberately has no nav entry — the page and its route are
// untouched and still build/serve normally at /photography/archive/, it's
// just not advertised anywhere a visitor would click. `current` still
// accepts 'archive' (the page itself still passes it) so nothing breaks;
// it simply never matches a link here any more.
const links = [
  { key: 'selected', label: 'Selected Work', href: '/photography/selected/' },
  { key: 'about', label: 'About', href: '/photography/about/' },
] as const;
---

<nav class="photography-nav" aria-label="Photography">
  {
    links.map((link) => (
      <a href={link.href} aria-current={link.key === current ? 'page' : undefined}>
        {link.label}
      </a>
    ))
  }
  {
    /* Hidden until a first photograph is actually saved (see saved.ts's
       syncSavedUI, which every [data-saved-link] on a page defers to,
       this one included) — an empty "Saved" destination would just be
       clutter on a page a browsing-only visitor never uses. */
  }
  <a
    href="/photography/saved/"
    class="saved-nav-link"
    data-saved-link
    aria-current={current === 'saved' ? 'page' : undefined}
  >
    Saved <span data-saved-count>0</span>
  </a>
</nav>

<script>
  import { syncSavedUI } from './saved.ts';
  syncSavedUI();
</script>

<style>
  .photography-nav {
    display: flex;
    gap: 1.25rem;
    margin: 0 0 3rem;
    font-family: var(--serif);
    font-variant-caps: small-caps;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
  }
  .photography-nav a {
    color: var(--muted);
    text-decoration: none;
    padding-bottom: 0.1875rem;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0% 1px;
    transition:
      background-size 0.25s ease,
      color 0.2s ease;
  }
  .photography-nav a:hover {
    color: var(--accent);
    background-size: 100% 1px;
  }
  .photography-nav a[aria-current='page'] {
    color: var(--ink);
    background-size: 100% 1px;
  }
  .saved-nav-link {
    display: none;
  }
  .saved-nav-link.is-shown {
    display: inline;
  }
</style>
