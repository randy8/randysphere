---
import type { Variant } from './manifest.ts';
import { photography } from './config.ts';
import { assetUrl, largest, smallest, srcset, variantsOf } from './image.ts';
import type { ArchivePhoto } from './archive.ts';

interface Props {
  entry: ArchivePhoto;
  sizes: string;
  /** True for the one image a page treats as its largest paint. */
  priority?: boolean;
  /**
   * Wrap the photograph in a link to its full-size JPEG. This is what makes the
   * gallery usable without JavaScript, but it has to be off wherever the caller
   * has already provided a link, because nested anchors are invalid HTML.
   */
  linked?: boolean;
  /**
   * Drop any variant wider than this from every format's srcset — for a
   * caller that already knows this photo will only ever render as a small
   * grid tile (never full-bleed), the largest configured tiers are pure
   * unused markup weight, not a real quality option `sizes` would ever
   * actually pick. Unset (the default) keeps every configured width, which
   * every full-size/Browse usage still needs. Never drops a format down to
   * zero variants — falls back to the single smallest one it has.
   */
  maxWidth?: number;
}

const { entry, sizes, priority = false, linked = true, maxWidth } = Astro.props;
const { photo, alt } = entry;
const base = photography.imageBaseUrl;

function capped(variants: readonly Variant[]): readonly Variant[] {
  if (maxWidth === undefined) return variants;
  const kept = variants.filter((variant) => variant.width <= maxWidth);
  return kept.length > 0 ? kept : variants.slice(0, 1);
}

const avif = capped(variantsOf(photo, 'avif'));
const webp = capped(variantsOf(photo, 'webp'));
const jpeg = capped(variantsOf(photo, 'jpeg'));

const fallback = smallest(photo, 'jpeg') ?? photo.variants[0];
const full = largest(photo, 'jpeg') ?? fallback;
const orientation = photo.height > photo.width ? 'portrait' : 'landscape';

if (fallback === undefined || full === undefined) {
  throw new Error(`${photo.file} has no usable variants. Run \`pnpm ingest\`.`);
}

// A flat colour until the bytes arrive. The inline placeholder is spent only on
// the image that is the largest paint, where it is worth the markup.
const placeholder = priority
  ? `background-color:${photo.color};background-image:url(${photo.lqip})`
  : `background-color:${photo.color}`;
---

<Fragment>
  {linked ? (
    <a class="photo" data-orientation={orientation} href={assetUrl(base, full.key)}>
      <picture>
        {avif.length > 0 && <source type="image/avif" srcset={srcset(base, avif)} sizes={sizes} />}
        {webp.length > 0 && <source type="image/webp" srcset={srcset(base, webp)} sizes={sizes} />}
        <img
          src={assetUrl(base, fallback.key)}
          srcset={jpeg.length > 1 ? srcset(base, jpeg) : undefined}
          sizes={jpeg.length > 1 ? sizes : undefined}
          width={photo.width}
          height={photo.height}
          alt={alt}
          loading={priority ? 'eager' : 'lazy'}
          decoding={priority ? 'sync' : 'async'}
          fetchpriority={priority ? 'high' : undefined}
          style={placeholder}
        />
      </picture>
    </a>
  ) : (
    <picture class="photo" data-orientation={orientation}>
      {avif.length > 0 && <source type="image/avif" srcset={srcset(base, avif)} sizes={sizes} />}
      {webp.length > 0 && <source type="image/webp" srcset={srcset(base, webp)} sizes={sizes} />}
      <img
        src={assetUrl(base, fallback.key)}
        srcset={jpeg.length > 1 ? srcset(base, jpeg) : undefined}
        sizes={jpeg.length > 1 ? sizes : undefined}
        width={photo.width}
        height={photo.height}
        alt={alt}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : undefined}
        style={placeholder}
      />
    </picture>
  )}
</Fragment>
