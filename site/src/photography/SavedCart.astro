---
/**
 * Saved, in the site-wide masthead (Base.astro), after the collections
 * list: the word and its count, in the navigation's own label voice. It
 * was a shopping-cart icon until 2026-10-26 — on a site where nothing is
 * for sale, a cart named the feature wrongly and brought commerce into an
 * archive. The count is the same localStorage list Saved has always read
 * (saved.ts), kept in step by syncSavedUI on every page, across tabs too.
 */
interface Props {
  current: boolean;
}

const { current } = Astro.props;
---

<div class="nameplate-cart">
  <a
    href="/exposures/saved/"
    class="saved-cart"
    data-saved-cart
    aria-label="Saved"
    aria-current={current ? 'page' : undefined}
  >
    Saved
    {/* Empty, and hidden, until there's something saved. */}
    <span class="saved-cart-count" data-saved-count hidden></span>
  </a>
</div>

<script>
  import { syncSavedAcrossTabs, syncSavedUI } from './saved.ts';
  syncSavedUI();
  syncSavedAcrossTabs();
</script>

<style is:global>
  /* A utility, not a collection: after the list, set apart by a hairline,
     the way a colophon separates the publisher's mark from the contents. */
  .nameplate-cart {
    display: flex;
    align-self: baseline;
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
  }
  /* The collection links' voice — muted at rest, ink when it's the page
     you're on, the accent on hover. The padding is touch room; the
     negative margin keeps it out of the layout. */
  .masthead-nameplate a.saved-cart {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    margin: -0.5rem;
    padding: 0.5rem;
    font-family: var(--serif);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .masthead-nameplate a.saved-cart:hover,
  .masthead-nameplate a.saved-cart:focus-visible {
    color: var(--accent);
  }
  .masthead-nameplate a.saved-cart[aria-current='page'] {
    color: var(--ink);
  }
  /* The count in the same figures as the word — no bubble, no colour of
     its own. */
  .saved-cart-count {
    font-variant-numeric: lining-nums tabular-nums;
  }
  .saved-cart-count[hidden] {
    display: none;
  }
  /* A phone: the collections wrap below the site title, so Saved moves up
     opposite the title instead of trailing onto a line of its own. */
  @media (max-width: 40rem) {
    .nameplate-cart {
      order: 1;
      margin-left: auto;
      padding-left: 0;
      border-left: 0;
    }
    .masthead-nameplate .nameplate-list {
      order: 2;
      flex-basis: 100%;
    }
  }
</style>
