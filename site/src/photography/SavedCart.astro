---
/**
 * Saved, in the site-wide masthead (Base.astro), after the collections
 * list: the word in the navigation's own label voice, the cart mark after
 * it, and the count once something is saved — one link. (The mark was
 * dropped for the word alone on 2026-10-26 and restored the same day at
 * the owner's request: the word names it, the mark is how people spot it.)
 * The count is the same localStorage list Saved has always read
 * (saved.ts), kept in step by syncSavedUI on every page, across tabs too.
 */
interface Props {
  current: boolean;
}

const { current } = Astro.props;
---

<div class="nameplate-cart">
  <a
    href="/exposures/saved/"
    class="saved-cart"
    data-saved-cart
    aria-label="Saved"
    aria-current={current ? 'page' : undefined}
  >
    Saved
    <svg
      class="saved-cart-icon"
      viewBox="0 0 24 24"
      width="15"
      height="15"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M2 3.5h2.6l2.5 11.1a1.5 1.5 0 0 0 1.5 1.2h8.7a1.5 1.5 0 0 0 1.45-1.12L21 7.5H5.5"
      ></path>
      <circle cx="9.5" cy="19.75" r="1.25"></circle>
      <circle cx="17" cy="19.75" r="1.25"></circle>
    </svg>
    {/* Empty, and hidden, until there's something saved. */}
    <span class="saved-cart-count" data-saved-count hidden></span>
  </a>
</div>

<script>
  import { syncSavedAcrossTabs, syncSavedUI } from './saved.ts';
  syncSavedUI();
  syncSavedAcrossTabs();
</script>

<style is:global>
  /* A utility, not a collection: after the list, set apart by a hairline,
     the way a colophon separates the publisher's mark from the contents. */
  .nameplate-cart {
    display: flex;
    align-self: baseline;
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
  }
  /* The collection links' voice — muted at rest, ink when it's the page
     you're on, the accent on hover. The padding is touch room; the
     negative margin keeps it out of the layout. */
  .masthead-nameplate a.saved-cart {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    margin: -0.5rem;
    padding: 0.5rem;
    font-family: var(--serif);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .masthead-nameplate a.saved-cart:hover,
  .masthead-nameplate a.saved-cart:focus-visible {
    color: var(--accent);
  }
  .masthead-nameplate a.saved-cart[aria-current='page'] {
    color: var(--ink);
  }
  /* Sized to the capitals beside it and seated on their baseline. */
  .saved-cart-icon {
    flex: none;
    align-self: center;
    margin-top: -0.125rem;
  }
  /* The count in the same figures as the word — no bubble, no colour of
     its own. */
  .saved-cart-count {
    font-variant-numeric: lining-nums tabular-nums;
  }
  .saved-cart-count[hidden] {
    display: none;
  }
  /* A phone: the collections wrap below the site title, so Saved moves up
     opposite the title instead of trailing onto a line of its own. */
  @media (max-width: 40rem) {
    .nameplate-cart {
      order: 1;
      margin-left: auto;
      padding-left: 0;
      border-left: 0;
    }
    .masthead-nameplate .nameplate-list {
      order: 2;
      flex-basis: 100%;
    }
  }
</style>
