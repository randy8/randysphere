---
import '../styles/base.css';
import { site } from '../config.ts';
import { collections } from '../collections.ts';
import SavedCart from '../photography/SavedCart.astro';

interface Props {
  title: string;
  description?: string;
  /** An absolute URL — pages that have one pass a photograph's `og` crop; most pages have none. */
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  /**
   * The page alone, with no masthead, footer or column — for a page that
   * is the whole screen (the exhibition). Everything in <head> stays.
   */
  bare?: boolean;
  /** The browser chrome's colour; the paper unless a page is mostly something else. */
  themeColor?: string;
}

const {
  title,
  description = site.description,
  image,
  imageWidth,
  imageHeight,
  bare = false,
  themeColor = '#f6f1e6',
} = Astro.props;
const { pathname } = Astro.url;
const fullTitle = title === site.title ? title : `${title} — ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// `image` is an override, not opt-in — a page with no natural photo still
// gets a real social card instead of a blank one.
const ogImage = image ?? new URL('/og-default.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={themeColor} />
    <link
      rel="preload"
      href="/fonts/newsreader-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={ogImage} />
    {image && imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {image && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}

    {
      /* Prefetch on intent: a pointer resting ~200 ms on a same-site link
         (or a press, on touch) fetches that page's HTML, so the click lands
         on a page already downloaded. Not prerender: that would also run
         the page's scripts (a fresh shuffle) invisibly. Excluded: /p/ —
         every grid tile links to its full-size 2560 px JPEG, which hovering
         a grid must never pull — and /private. Browsers without speculation
         rules ignore this. See docs/decisions.md, 2026-10-25. */
    }
    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": "/p/*" } },
                { "not": { "href_matches": "/private*" } },
                { "not": { "selector_matches": "[target=_blank]" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
    {
      /* A refresh starts the page over at the top: photo pages deal a new
         arrangement on reload, so the old scroll position points at
         nothing. Back and Forward still return to where you were (the
         setting goes back to automatic as the page is left), and a
         #fragment still scrolls to its target. */
    }
    <script is:inline>
      try {
        if (performance.getEntriesByType('navigation')[0]?.type === 'reload') {
          history.scrollRestoration = 'manual';
          addEventListener('pagehide', () => {
            history.scrollRestoration = 'auto';
          });
        }
      } catch {
        // Without the API, the browser's own behaviour stands.
      }
    </script>
  </head>
  <body>
    {bare && <slot />}
    {
      !bare && (
        <Fragment>
          <a class="skip-link" href="#content">Skip to content</a>
          <div class="wrap">
            <header class="masthead">
              {
                /* The one collections list every page shares (title, a thin
                   rule, every collection). The site name always links home; the
                   current collection is marked as current and still links to its
                   own front page — from a tag or film page, and from the front
                   page itself, where it clears a filter (?film=…) and, on
                   Selected Work, deals a fresh order. An ordinary
                   in-flow header that scrolls away with the page — not sticky,
                   so it never sits over a photograph; the lightbox paints over
                   it while open. See .masthead-nameplate in base.css and
                   docs/decisions.md, 2026-08-28, 2026-10-06, and 2026-10-16. */
              }
              <div class="masthead-nameplate">
                <p class="nameplate-title">
                  <a href="/">{site.title}</a>
                </p>
                <ul class="nameplate-list">
                  {
                    collections.map((collection) => (
                      <li>
                        {pathname.startsWith(`/${collection.slug}/`) ? (
                          <a
                            class="nameplate-current"
                            href={collection.href}
                            aria-current={pathname === collection.href ? 'page' : 'true'}
                          >
                            {collection.title}
                          </a>
                        ) : (
                          <a href={collection.href}>{collection.title}</a>
                        )}
                      </li>
                    ))
                  }
                </ul>
                {
                  /* The one exception to this layout knowing nothing about any
                     collection: Saved, as a cart, reachable from every page. See
                     docs/decisions.md, 2026-10-25. */
                }
                <SavedCart current={pathname.startsWith('/exposures/saved/')} />
              </div>
            </header>
            <main id="content">
              <slot />
            </main>
            <footer class="site-footer">
              <span>© {new Date().getFullYear()} {site.author}</span>
              <a href="/system">Site status</a>
            </footer>
          </div>
        </Fragment>
      )
    }
  </body>
</html>
