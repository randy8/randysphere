---
import '../styles/base.css';
import { site } from '../config.ts';
import { collections } from '../collections.ts';

interface Props {
  title: string;
  description?: string;
  /** An absolute URL — pages that have one pass a photograph's `og` crop; most pages have none. */
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const { title, description = site.description, image, imageWidth, imageHeight } = Astro.props;
const { pathname } = Astro.url;
const fullTitle = title === site.title ? title : `${title} — ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// `image` is an override, not opt-in — a page with no natural photo still
// gets a real social card instead of a blank one.
const ogImage = image ?? new URL('/og-default.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f1e6" />
    <link
      rel="preload"
      href="/fonts/newsreader-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={ogImage} />
    {image && imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {image && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="wrap">
      <header class="masthead">
        {
          /* The exact same nameplate Browse.astro floats over a photo in
             browse mode (title, a thin rule, every collection underneath,
             the current one inert) — same markup, same
             nameplate-title/-list/-current classes, so the two literally
             cannot drift apart visually. Only the wrapper differs: no
             position:fixed, no mix-blend-mode, no opacity fade, because
             this one sits in a normal (if sticky) header with its own
             opaque background rather than floating over arbitrary photo
             content — see .masthead-nameplate in base.css. Browse mode
             hides this whole header and shows its own floating copy
             instead, because browse mode hides ALL of Base's chrome to
             stay full-bleed over the photograph; everywhere else (recipes,
             films, music, /collections/, and photography before/without
             JS) this is the only such list, so it needs to actually be
             here. See docs/decisions.md, 2026-08-28. */
        }
        <div class="masthead-nameplate">
          <p class="nameplate-title">{site.title}</p>
          <ul class="nameplate-list">
            {
              collections.map((collection) => (
                <li>
                  {pathname.startsWith(`/${collection.slug}/`) ? (
                    <span class="nameplate-current" aria-current="page">
                      {collection.title}
                    </span>
                  ) : (
                    <a href={collection.href}>{collection.title}</a>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </header>
      <main id="content">
        <slot />
      </main>
      <footer class="site-footer">© {new Date().getFullYear()} {site.author}</footer>
    </div>
  </body>
</html>
