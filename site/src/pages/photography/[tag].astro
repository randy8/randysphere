---
import Browse from '../../photography/Browse.astro';
import Photo from '../../photography/Photo.astro';
import Base from '../../layouts/Base.astro';
import PhotographyNav from '../../photography/PhotographyNav.astro';
import { allTags, loadArchive, viewForTag } from '../../photography/archive.ts';
import type { View } from '../../photography/archive.ts';
import { ogImageOf } from '../../photography/image.ts';
import { photography } from '../../photography/config.ts';

export function getStaticPaths() {
  const archive = loadArchive();
  const tags = allTags(archive);
  // Same order /photography/archive/ lists albums in (allTags is
  // alphabetical) — "next" reuses the sequence a visitor already sees
  // there rather than inventing a second ordering. The last tag gets no
  // next view, same as a book's last chapter.
  return tags.map((tag, index) => {
    const nextTag = tags[index + 1];
    return {
      params: { tag },
      props: {
        view: viewForTag(archive, tag),
        nextView: nextTag !== undefined ? viewForTag(archive, nextTag) : null,
      },
    };
  });
}

interface Props {
  view: View;
  nextView: View | null;
}

const { view, nextView } = Astro.props;
const hero = view.photos[0]?.photo;
const og = hero ? ogImageOf(photography.imageBaseUrl, hero, Astro.site) : undefined;
const next = nextView
  ? { tag: nextView.tag, title: nextView.title, date: nextView.date, count: nextView.photos.length }
  : null;
---

<Base title={view.title} description={view.title} image={og?.image} imageWidth={og?.imageWidth} imageHeight={og?.imageHeight}>
  {
    /*
      Browse (one photograph at a time, left to right) is the only reading
      experience with JavaScript on — this runs before the rest of the page
      paints so there's no flash of the grid first. The grid below is the
      no-JS fallback only: without this script running at all, is-browsing
      never gets added and the plain grid of real links is what renders.
      `document.body` already exists here regardless of where in the body
      this tag sits.
    */
  }
  <script is:inline>
    document.body.classList.add('is-browsing');
  </script>

  <PhotographyNav current="archive" />
  <header class="album-header">
    {
      view.roll?.filmStock && (
        <p class="eyebrow">
          <a href={`/photography/film/${view.roll.filmStock}/`}>{view.roll.filmStock}</a>
          {view.date && ` · ${view.date}`}
        </p>
      )
    }
    {!view.roll?.filmStock && view.date && <p class="eyebrow">{view.date}</p>}
    <h1>{view.title}</h1>
  </header>

  <div class="grid" data-grid>
    {
      view.photos.map((entry, index) => (
        <figure data-photo-id={entry.photo.sourceId}>
          <Photo
            entry={entry}
            sizes="(min-width: 64rem) 11vw, (min-width: 40rem) 17vw, 45vw"
            priority={index === 0}
            maxWidth={1280}
          />
          <span class="frame-mark" aria-hidden="true">
            {String(entry.frame).padStart(2, '0')}
          </span>
        </figure>
      ))
    }
  </div>

  {
    /* The no-JS/grid-mode counterpart to Browse.astro's outro panel — same
       destination, plain-link register, always visible rather than reached
       by scrolling to the end of a reading view that doesn't exist here. */
    next && (
      <p class="next-album">
        <a href={`/photography/${next.tag}/`}>Next: {next.title} →</a>
      </p>
    )
  }

  <Browse view={view} next={next} />

  <script>
    import '../../photography/browse.ts';
  </script>
</Base>
