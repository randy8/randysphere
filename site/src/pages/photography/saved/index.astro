---
import Browse from '../../../photography/Browse.astro';
import Photo from '../../../photography/Photo.astro';
import Base from '../../../layouts/Base.astro';
import PhotographyNav from '../../../photography/PhotographyNav.astro';
import { loadArchive } from '../../../photography/archive.ts';
import type { View } from '../../../photography/archive.ts';
import { photography } from '../../../photography/config.ts';

const archive = loadArchive();

// The server has no idea what's saved (that's localStorage, entirely
// client-side) — this page renders the whole archive, as a grid and as a
// Browse stack, and saved-view.ts prunes both down to the saved subset
// before a visitor ever sees them. Archive order throughout: "Saved" is a
// filter over the archive, not a separately-ordered list.
const view: View = { tag: 'saved', title: 'Saved', date: null, photos: archive.photos, roll: null };
---

<Base
  title={`Saved — ${photography.title}`}
  description="Photographs saved to revisit later. Stored only in this browser."
>
  <PhotographyNav current="saved" />
  <header class="album-header saved-header">
    <h1>Saved</h1>
    <p class="saved-meta">
      <span class="saved-summary" data-saved-summary hidden></span>
      <span class="saved-actions" data-saved-actions hidden>
        <button type="button" class="saved-share" data-share-saved>
          Share
        </button>
        <span class="saved-actions-sep" aria-hidden="true">·</span>
        <button type="button" class="saved-clear" data-clear-saved>
          Clear
        </button>
      </span>
    </p>
  </header>

  <p class="saved-empty" data-saved-empty>
    Nothing saved yet — saved photographs are stored only in this browser.
  </p>
  <noscript>
    <p class="saved-empty">Saving photographs requires JavaScript.</p>
  </noscript>

  <ul class="saved-grid" data-saved-grid>
    {
      archive.photos.map((entry, index) => (
        <li data-photo-id={entry.photo.sourceId}>
          <Photo
            entry={entry}
            sizes="(min-width: 40rem) 30vw, 46vw"
            priority={index === 0}
          />
          <button type="button" class="saved-grid-remove" data-remove-saved aria-label="Remove from Saved">
            <span aria-hidden="true">×</span>
          </button>
        </li>
      ))
    }
  </ul>

  <Browse view={view} intro={false} exitToGrid="Saved" />

  {
    /* saved-view.ts prunes the grid and the Browse stack down to the saved
       subset — it has to run, and finish, before browse.ts reads that same
       stack to build its own items/ids. Both are plain type="module"
       scripts, which execute in document order (the same ordering trick
       selected/index.astro's own inline shuffle script already relies on,
       just ahead of its browse.ts import too), so listing this one first
       is what makes that guarantee hold. */
  }
  <script>
    import '../../../photography/saved-view.ts';
  </script>
  <script>
    import '../../../photography/browse.ts';
  </script>
</Base>
