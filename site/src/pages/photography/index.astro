---
import Photo from '../../photography/Photo.astro';
import Base from '../../layouts/Base.astro';
import PhotographyNav from '../../photography/PhotographyNav.astro';
import { loadArchive, selectedWork } from '../../photography/archive.ts';
import { photography } from '../../photography/config.ts';
import { ogImageOf } from '../../photography/image.ts';

const archive = loadArchive();
// A small taste, not a summary of the whole archive — Home's only job is to
// hand off to Selected Work, Archive, or About. See docs/decisions.md.
// Every featured photo renders (not just nine) so the inline script below
// can shuffle and pick a fresh nine on each load; PREVIEW_COUNT is only
// the server-rendered (no-JS) fallback count — the first nine by
// featuredOrder, same as before this got randomized.
const PREVIEW_COUNT = 9;
const preview = selectedWork(archive);
const hero = preview[0]?.photo;
const og = hero ? ogImageOf(photography.imageBaseUrl, hero, Astro.site) : undefined;
---

<Base
  title={photography.title}
  description={photography.description}
  image={og?.image}
  imageWidth={og?.imageWidth}
  imageHeight={og?.imageHeight}
>
  <PhotographyNav current="home" />
  <header class="photography-home-header">
    <h1>{photography.title}</h1>
    <p class="lede">{photography.description}</p>
  </header>

  {
    preview.length > 0 && (
      <ul class="photography-home-preview" data-home-preview>
        {preview.map((entry, index) => (
          <li class:list={[index >= PREVIEW_COUNT && 'photography-home-preview-hidden']}>
            <a href={`/photography/selected/#photo-${entry.photo.sourceId}`}>
              <Photo
                entry={entry}
                sizes="(min-width: 64rem) 15vw, (min-width: 48rem) 22vw, 92vw"
                priority={index === 0}
                linked={false}
              />
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    preview.length > PREVIEW_COUNT && (
      <script is:inline define:vars={{ PREVIEW_COUNT }}>
        {
          /* A fresh nine (and a fresh order) each load, from the full
             featured pool — the no-JS/pre-shuffle fallback above is the
             first nine by featuredOrder, so this only ever improves on
             what's already a reasonable static default. */
        }
        const list = document.querySelector('[data-home-preview]');
        if (list) {
          const items = Array.from(list.children);
          for (let i = items.length - 1; i > 0; i -= 1) {
            const j = Math.floor(Math.random() * (i + 1));
            [items[i], items[j]] = [items[j], items[i]];
          }
          items.forEach((item, index) => {
            list.appendChild(item);
            item.classList.toggle('photography-home-preview-hidden', index >= PREVIEW_COUNT);
          });
        }
      </script>
    )
  }

  <p class="photography-home-cue">
    <a href="/photography/selected/">
      View Selected Work <span class="photography-home-cue-arrow" aria-hidden="true">→</span>
    </a>
  </p>
</Base>

<style>
  .photography-home-header {
    margin: 4rem 0 3.5rem;
    animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .photography-home-preview {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 0 0 3rem;
    padding: 0;
    list-style: none;
  }
  .photography-home-preview-hidden {
    display: none;
  }
  /*
   * :global() is required on every selector that reaches `.photo` or its
   * descendants: that markup is rendered by the child <Photo> component,
   * not by this file, and Astro's per-component style scoping (a
   * data-astro-cid-* attribute stamped onto both a scoped selector and the
   * elements a component renders itself) never reaches across that
   * boundary. Without it these rules compile to a selector that can never
   * match anything, and silently do nothing rather than erroring — this
   * was found by comparing computed styles against DOM scope attributes
   * directly, not by inspection alone.
   */
  .photography-home-preview :global(.photo) {
    overflow: hidden;
    display: block;
  }
  .photography-home-preview :global(.photo img) {
    transition: transform 0.5s ease;
  }
  /* A fixed 3-column grid with a shared row height leaves a gap wherever a
     portrait photo lands next to a landscape one — the row's height is set
     by the tallest cell, and the shorter photo doesn't fill it. A CSS grid
     with a shared column width instead (the same technique base.css's
     `.grid` uses) solves this without cropping anything: every photo keeps
     its own aspect ratio and its own height, and every row's outer edge
     still lands flush on the same grid line, however many photos are in
     it. */
  @media (min-width: 48rem) {
    .photography-home-preview {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
      align-items: start;
    }
    .photography-home-preview li > a {
      display: block;
    }
  }
  @media (hover: hover) {
    .photography-home-preview a:hover :global(.photo img) {
      transform: scale(1.035);
    }
  }
  .photography-home-cue {
    margin: 0 0 4rem;
  }
  .photography-home-cue a {
    font-family: var(--serif);
    font-variant-caps: small-caps;
    font-size: 1.0625rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .photography-home-cue a:hover {
    color: var(--accent);
  }
  .photography-home-cue-arrow {
    display: inline-block;
    transition: transform 0.25s ease;
  }
  .photography-home-cue a:hover .photography-home-cue-arrow {
    transform: translateX(0.25rem);
  }
</style>
