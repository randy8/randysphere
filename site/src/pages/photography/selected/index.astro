---
import Browse from '../../../photography/Browse.astro';
import Photo from '../../../photography/Photo.astro';
import Base from '../../../layouts/Base.astro';
import PhotographyNav from '../../../photography/PhotographyNav.astro';
import { loadArchive, selectedWork } from '../../../photography/archive.ts';
import type { View } from '../../../photography/archive.ts';
import { ogImageOf } from '../../../photography/image.ts';
import { photography } from '../../../photography/config.ts';

const archive = loadArchive();
const photos = selectedWork(archive);

// Selected Work is a hand-picked, hand-ordered sequence across the whole
// archive — not a tag, so it is never built through viewForTag. This is the
// same View shape Browse.astro already reads, built directly instead.
const view: View = { tag: 'selected', title: 'Selected Work', date: null, photos, roll: null };
const hero = photos[0]?.photo;
const og = hero ? ogImageOf(photography.imageBaseUrl, hero, Astro.site) : undefined;
---

<Base
  title="Selected Work — Photography"
  description="A curated sequence of photographs."
  image={og?.image}
  imageWidth={og?.imageWidth}
  imageHeight={og?.imageHeight}
>
  {
    /* Same as every other photography page now: browse mode opens
       immediately, before the rest of the page paints, so there's no flash
       of the grid first. The grid below is the no-JS fallback only. */
    photos.length > 0 && (
      <script is:inline>
        document.body.classList.add('is-browsing');
      </script>
    )
  }

  <PhotographyNav current="selected" />

  {
    photos.length === 0 ? (
      <header class="album-header">
        <h1>Selected Work</h1>
        <p class="lede">
          Nothing is marked as Selected Work yet — mark a photo <code>featured: true</code> in its
          batch's photos.yaml to have it appear here.
        </p>
      </header>
    ) : (
      <Fragment>
        <header class="album-header">
          <h1>Selected Work</h1>
        </header>

        <div class="grid" data-grid>
          {photos.map((entry, index) => (
            <figure data-photo-id={entry.photo.sourceId}>
              <Photo
                entry={entry}
                sizes="(min-width: 64rem) 11vw, (min-width: 40rem) 17vw, 45vw"
                priority={index === 0}
              />
            </figure>
          ))}
        </div>

        <Browse view={view} />

        {
          /*
            featuredOrder (see archive.ts's selectedWork()) is still the
            real editorial sequence — the one thing that renders before any
            script runs, and the no-JS fallback (the grid above keeps that
            fixed order; nothing reshuffles it, since JS never shows it).
            This reshuffles only the browse sequence into a fresh random
            order on top of it, once per page load, so scrolling through
            Selected Work doesn't show the same fixed lineup every time you
            look. Runs as a synchronous inline script, before browse.ts's
            own deferred module script below, so browse.ts's init() only
            ever sees the already-shuffled DOM — never re-syncs on its own,
            so a reload reshuffles again, which is the point.
          */
        }
        <script is:inline>
          {
            const stack = document.querySelector('[data-browse-stack]');
            if (stack) {
              const items = Array.from(stack.querySelectorAll('[data-photo-id]'));
              const ids = items.map((el) => el.dataset.photoId);
              for (let i = ids.length - 1; i > 0; i -= 1) {
                const j = Math.floor(Math.random() * (i + 1));
                [ids[i], ids[j]] = [ids[j], ids[i]];
              }
              const byId = new Map(items.map((el) => [el.dataset.photoId, el]));
              for (const id of ids) {
                const el = byId.get(id);
                if (el) stack.appendChild(el);
              }
            }
          }
        </script>

        <script>
          import '../../../photography/browse.ts';
        </script>
      </Fragment>
    )
  }
</Base>
