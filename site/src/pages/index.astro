---
import Base from '../layouts/Base.astro';
import { collections } from '../collections.ts';
import { site } from '../config.ts';
---

{
  /*
    The masthead (Base.astro) already carries the site identity on every
    page — repeating "Randy Liang" as this page's own h1 right underneath it
    said the same thing twice within a few lines. The h1 here introduces the
    page instead of re-announcing who it belongs to.
  */
}
<Base title={site.title}>
  <header class="album-header home-header">
    <h1>{site.description}</h1>
  </header>

  <ul class="archive-index">
    {
      collections.map((collection) => (
        <li>
          <a href={collection.href}>
            <h2>{collection.title}</h2>
            {collection.description && <p class="lede">{collection.description}</p>}
            <p class="archive-index-stats">{collection.stats()}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
