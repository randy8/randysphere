---
import Photo from '../components/Photo.astro';
import Base from '../layouts/Base.astro';
import { allTags, coverPhoto, loadArchive, viewForTag } from '../lib/archive.ts';
import { site } from '../config.ts';

const archive = loadArchive();
const views = allTags(archive).map((tag) => viewForTag(archive, tag));
---

<Base title={site.title}>
  <header class="album-header">
    <p class="eyebrow">Projects</p>
    <h1>{site.title}</h1>
    <p class="lede">{site.description}</p>
  </header>

  <ul class="albums">
    {
      views.map((view, index) => (
        <li class="album-card">
          <a href={`/projects/${view.tag}/`}>
            <figure>
              <Photo
                entry={coverPhoto(view.photos)}
                sizes="(min-width: 76rem) 72rem, 100vw"
                priority={index === 0}
                linked={false}
              />
              <figcaption>
                <h2>{view.title}</h2>
                {view.date && <span class="meta">{view.date}</span>}
              </figcaption>
            </figure>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
