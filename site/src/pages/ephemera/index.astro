---
import Base from '../../layouts/Base.astro';
import { ephemera } from '../../ephemera.ts';

const number = (index: number): string => String(index + 1).padStart(2, '0');
// The board drawing: six categories of five, a few already played.
const played = new Set(['0-0', '1-2', '2-0', '2-1', '3-4', '4-1', '5-0', '5-3']);
---

{
  /*
    Side projects: a shelf of cards, each like a ticket or label kept in a
    drawer. Almost no words; the drawing does the talking. The last card is
    the empty slot, so a short shelf still reads as a beginning.
  */
}
<Base title="Ephemera" description="Side projects.">
  <header class="album-header home-header">
    <h1>Ephemera</h1>
  </header>

  <ul class="ephemera">
    {
      ephemera.map((item, index) => {
        const inner = (
          <>
            <p class="ephemera-meta">
              <span>No. {number(index)}</span>
              <span class="ephemera-kind">{item.kind}</span>
            </p>
            {item.glyph === 'board' && (
              <svg class="ephemera-glyph" viewBox="0 0 122 102" aria-hidden="true">
                {[0, 1, 2, 3, 4, 5].map((col) =>
                  [0, 1, 2, 3, 4].map((row) => (
                    <rect
                      class={played.has(`${col}-${row}`) ? 'played' : undefined}
                      x={col * 20 + 1.5}
                      y={row * 20 + 1.5}
                      width="18"
                      height="18"
                    />
                  )),
                )}
              </svg>
            )}
            <h2>{item.title}</h2>
          </>
        );
        return (
          <li class:list={['ephemera-card', { 'ephemera-idea': !item.href }]}>
            {item.href ? <a href={item.href}>{inner}</a> : <div>{inner}</div>}
          </li>
        );
      })
    }
    <li class="ephemera-card ephemera-drawer" aria-hidden="true">
      <div>
        <p class="ephemera-meta"><span>No. {number(ephemera.length)}</span></p>
        <p class="ephemera-drawer-text">Soon.</p>
      </div>
    </li>
  </ul>
</Base>
