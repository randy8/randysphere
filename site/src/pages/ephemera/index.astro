---
import Base from '../../layouts/Base.astro';
import { ephemera } from '../../ephemera.ts';

const number = (index: number): string => String(index + 1).padStart(2, '0');
---

{
  /*
    A portal, not a collection: apps and ideas too small for the masthead.
    Each is a card, like a ticket or label kept in a drawer: a catalogue
    number, what kind of thing it is, and a way in. The last card is the
    drawer itself, so a short list still reads as a beginning.
  */
}
<Base title="Ephemera" description="Little things I've made, and a few I'm still thinking about.">
  <header class="album-header home-header ephemera-header">
    <h1>Ephemera</h1>
    <p class="lede">Little things I've made, and a few I'm still thinking about.</p>
  </header>

  <ul class="ephemera">
    {
      ephemera.map((item, index) => {
        const inner = (
          <>
            <p class="ephemera-meta">
              <span>No. {number(index)}</span>
              <span class="ephemera-kind">{item.kind}</span>
            </p>
            {item.glyph === 'board' && (
              <svg class="ephemera-glyph" viewBox="0 0 66 34" aria-hidden="true">
                {[0, 1, 2, 3, 4, 5].map((col) =>
                  [0, 1, 2].map((row) => (
                    <rect x={col * 11 + 1} y={row * 11 + 1} width="9" height="9" />
                  )),
                )}
              </svg>
            )}
            <h2>{item.title}</h2>
            <p class="ephemera-description">{item.description}</p>
            <p class="ephemera-action">{item.href ? 'Open' : 'Still an idea'}</p>
          </>
        );
        return (
          <li class:list={['ephemera-card', { 'ephemera-idea': !item.href }]}>
            {item.href ? <a href={item.href}>{inner}</a> : <div>{inner}</div>}
          </li>
        );
      })
    }
    <li class="ephemera-card ephemera-drawer" aria-hidden="true">
      <div>
        <p class="ephemera-meta"><span>No. {number(ephemera.length)}</span></p>
        <p class="ephemera-drawer-text">More soon.</p>
      </div>
    </li>
  </ul>
</Base>
