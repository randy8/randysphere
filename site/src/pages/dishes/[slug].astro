---
import '../../recipes/recipes.css';
import Base from '../../layouts/Base.astro';
import { loadRecipes, loadVeganLibrary } from '../../recipes/recipes.ts';
import { renderInline, renderQuiet } from '../../recipes/markup.ts';
import type { Recipe } from '../../recipes/recipes.ts';
import { CONFIDENCE_LABEL, veganVersion } from '../../recipes/vegan.ts';
import type { VeganLine } from '../../recipes/vegan.ts';

export function getStaticPaths() {
  return loadRecipes().map((recipe) => ({ params: { slug: recipe.slug }, props: { recipe } }));
}

interface Props {
  recipe: Recipe;
}

const { recipe } = Astro.props;
// The recipe's second way to be prepared, worked out at build time from the
// substitution library (vegan.ts). Lines a swap changes are rendered twice;
// the page shows one version at a time (vegan-toggle.ts, and the CSS keyed
// on data-version below).
const vegan = veganVersion(recipe, loadVeganLibrary(), recipe.veganChoices);
const offerVegan = vegan.status === 'adaptable';
const both = (line: VeganLine, render: (text: string) => string): string =>
  offerVegan && line.vegan !== line.original
    ? `<span class="v-original">${render(line.original)}</span>` +
      `<span class="v-vegan">${render(line.vegan)}<span class="v-mark"> Swap</span></span>`
    : render(line.original);
---

<Base title={recipe.title} description={recipe.description}>
  <div class="recipe-scope" data-recipe-slug={recipe.slug}>
    <article class="recipe-doc" data-version="original">
      <header class="album-header">
        <h1>{recipe.title}</h1>
        <p class="recipe-doc-description">{recipe.description}</p>
        <p class="recipe-doc-meta">
          {recipe.prepTime && <span><strong>Prep</strong> {recipe.prepTime}</span>}
          {recipe.cookTime && <span><strong>Cook</strong> {recipe.cookTime}</span>}
          {recipe.totalTime && <span><strong>Total</strong> {recipe.totalTime}</span>}
          {recipe.servings && (
            <span>
              <strong>Serves</strong> <span data-servings-value>{recipe.servings}</span>
            </span>
          )}
          {recipe.difficulty && <span><strong>Difficulty</strong> {recipe.difficulty}</span>}
          {vegan.status === 'vegan' && <span><strong>Vegan</strong></span>}
        </p>
        <div class="recipe-controls">
          <p class="recipe-scale" role="group" aria-label="Scale ingredient quantities">
            <button type="button" data-scale-factor="0.5">½×</button>
            <button type="button" data-scale-factor="1" aria-pressed="true">1×</button>
            <button type="button" data-scale-factor="2">2×</button>
          </p>
          {
            /* Hidden until vegan-toggle.ts runs: it needs JavaScript. */
            offerVegan && (
              <p class="recipe-scale recipe-version" role="group" aria-label="Recipe version" data-version-toggle hidden>
                <button type="button" data-version-choice="original" aria-pressed="true">Original</button>
                <button type="button" data-version-choice="vegan" aria-pressed="false">Vegan</button>
              </p>
            )
          }
        </div>
        {
          vegan.unresolved.length > 0 && (
            <p class="recipe-doc-vegan-note">
              Not easily made vegan: {vegan.unresolved.map((swap) => swap.found.toLowerCase()).join(', ')} has no
              reliable swap here.
            </p>
          )
        }
      </header>

      <section class="recipe-doc-section" data-checklist="ingredients">
        <h2>
          Ingredients <span class="recipe-progress" data-recipe-progress />
        </h2>
        <ul class="recipe-doc-list recipe-doc-checklist">
          {vegan.ingredients.map((line) => (
            <li>
              <label>
                <input type="checkbox" class="recipe-check" />
                <span set:html={both(line, renderInline)} />
              </label>
            </li>
          ))}
        </ul>
      </section>

      {
        recipe.optionalIngredients.length > 0 && (
          <section class="recipe-doc-section" data-checklist="optional">
            <h2>
              Optional <span class="recipe-progress" data-recipe-progress />
            </h2>
            <ul class="recipe-doc-list recipe-doc-checklist">
              {vegan.optionalIngredients.map((line) => (
                <li>
                  <label>
                    <input type="checkbox" class="recipe-check" />
                    <span set:html={both(line, renderInline)} />
                  </label>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="recipe-doc-section" data-checklist="instructions">
        <h2>
          Instructions <span class="recipe-progress" data-recipe-progress />
        </h2>
        <ol class="recipe-doc-steps recipe-doc-checklist">
          {
            vegan.instructions.map((line) => (
              <li>
                <label>
                  <input type="checkbox" class="recipe-check" />
                  <span set:html={both(line, renderQuiet)} />
                </label>
              </li>
            ))
          }
        </ol>
      </section>

      {
        offerVegan && (
          <section class="recipe-doc-section v-only" aria-label="Vegan swaps">
            <h2>Vegan swaps</h2>
            <ul class="recipe-swaps">
              {vegan.swaps.map((swap) => (
                <li>
                  <p class="recipe-swap-head">
                    <span class="recipe-swap-from">{swap.found.toLowerCase()}</span>
                    <span aria-hidden="true"> → </span>
                    <span class="visually-hidden"> becomes </span>
                    <span class="recipe-swap-to">{swap.into.charAt(0).toLowerCase() + swap.into.slice(1)}</span>
                    <span class="recipe-swap-confidence">{CONFIDENCE_LABEL[swap.option.confidence]}</span>
                  </p>
                  {swap.option.products.length > 0 && (
                    <p class="recipe-swap-products">Try {swap.option.products.join(', ')}.</p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        /* The author's notes. Dropped from the page on 2026-08-10 (with
           the checklist rewrite) though every recipe kept writing them;
           restored 2026-10-26. */
        recipe.notes.length > 0 && (
          <section class="recipe-doc-section">
            <h2>Notes</h2>
            <ul class="recipe-doc-notes">
              {recipe.notes.map((note) => (
                <li set:html={renderQuiet(note)} />
              ))}
            </ul>
          </section>
        )
      }

      {
        recipe.brands.length > 0 && (
          <section class="recipe-doc-section">
            <h2>Brand suggestions</h2>
            <ul class="recipe-doc-notes">
              {recipe.brands.map((brand) => (
                <li set:html={renderQuiet(brand)} />
              ))}
            </ul>
          </section>
        )
      }

    </article>
  </div>

  <script>
    import '../../recipes/serving-scale.ts';
    import '../../recipes/checklist.ts';
    import '../../recipes/vegan-toggle.ts';
  </script>
</Base>
