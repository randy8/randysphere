---
import '../../recipes/recipes.css';
import Base from '../../layouts/Base.astro';
import { loadRecipes } from '../../recipes/recipes.ts';
import { renderInline, renderQuiet } from '../../recipes/markup.ts';
import type { Recipe } from '../../recipes/recipes.ts';

export function getStaticPaths() {
  return loadRecipes().map((recipe) => ({ params: { slug: recipe.slug }, props: { recipe } }));
}

interface Props {
  recipe: Recipe;
}

const { recipe } = Astro.props;
---

<Base title={recipe.title} description={recipe.description}>
  <div class="recipe-scope" data-recipe-slug={recipe.slug}>
    <article class="recipe-doc">
      <header class="album-header">
        <h1>{recipe.title}</h1>
        <p class="recipe-doc-description">{recipe.description}</p>
        <p class="recipe-doc-meta">
          {recipe.prepTime && <span><strong>Prep</strong> {recipe.prepTime}</span>}
          {recipe.cookTime && <span><strong>Cook</strong> {recipe.cookTime}</span>}
          {recipe.totalTime && <span><strong>Total</strong> {recipe.totalTime}</span>}
          {recipe.servings && (
            <span>
              <strong>Serves</strong> <span data-servings-value>{recipe.servings}</span>
            </span>
          )}
          {recipe.difficulty && <span><strong>Difficulty</strong> {recipe.difficulty}</span>}
        </p>
        <p class="recipe-scale" role="group" aria-label="Scale ingredient quantities">
          <button type="button" data-scale-factor="0.5">½×</button>
          <button type="button" data-scale-factor="1" aria-pressed="true">1×</button>
          <button type="button" data-scale-factor="2">2×</button>
        </p>
      </header>

      <section class="recipe-doc-section" data-checklist="ingredients">
        <h2>
          Ingredients <span class="recipe-progress" data-recipe-progress />
        </h2>
        <ul class="recipe-doc-list recipe-doc-checklist">
          {recipe.ingredients.map((item) => (
            <li>
              <label>
                <input type="checkbox" class="recipe-check" />
                <span set:html={renderInline(item)} />
              </label>
            </li>
          ))}
        </ul>
      </section>

      {
        recipe.optionalIngredients.length > 0 && (
          <section class="recipe-doc-section" data-checklist="optional">
            <h2>
              Optional <span class="recipe-progress" data-recipe-progress />
            </h2>
            <ul class="recipe-doc-list recipe-doc-checklist">
              {recipe.optionalIngredients.map((item) => (
                <li>
                  <label>
                    <input type="checkbox" class="recipe-check" />
                    <span set:html={renderInline(item)} />
                  </label>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="recipe-doc-section" data-checklist="instructions">
        <h2>
          Instructions <span class="recipe-progress" data-recipe-progress />
        </h2>
        <ol class="recipe-doc-steps recipe-doc-checklist">
          {
            recipe.instructions.map((step) => (
              <li>
                <label>
                  <input type="checkbox" class="recipe-check" />
                  <span set:html={renderQuiet(step)} />
                </label>
              </li>
            ))
          }
        </ol>
      </section>

    </article>
  </div>

  <script>
    import '../../recipes/serving-scale.ts';
    import '../../recipes/checklist.ts';
  </script>
</Base>
