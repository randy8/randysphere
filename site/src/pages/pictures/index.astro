---
import '../../films/films.css';
import Base from '../../layouts/Base.astro';
import {
  allGenres,
  excerpt,
  filmId,
  filmsByYearRated,
  formatRuntime,
  loadFilms,
} from '../../films/films.ts';
import { films as config } from '../../films/config.ts';

const films = loadFilms();
const groups = filmsByYearRated(films);
const genres = allGenres(films);
const years = films.map((film) => film.ratedOn.slice(0, 4)).filter((year) => year.length === 4);
const range =
  years.length > 0 ? `${[...years].sort().at(0)}–${[...years].sort().at(-1)}` : null;
const hasPosters = films.some((film) => film.posterPath !== null);
// "29 December": the day each film was seen (rated), as the catalogue line
// prints it. UTC, so the build machine's time zone never shifts a date.
const seenOn = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', timeZone: 'UTC' });
const seen = (iso: string): string | null =>
  /^\d{4}-\d{2}-\d{2}$/.test(iso) ? seenOn.format(new Date(`${iso}T00:00:00Z`)) : null;
const firstSeen = [...films].map((film) => film.ratedOn).filter((day) => seen(day) !== null).sort()[0];
const longDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base title={config.title} description={config.description}>
  <header class="album-header film-header">
    <h1>{config.title}</h1>
    <p class="lede">
      {films.length} film{films.length === 1 ? '' : 's'} rated five stars on Letterboxd{
        range && `, ${range}`
      }.
    </p>
    {
      /* The archive's contents: every year and how many films it holds,
         each a link to its section — the opening's space, put to work. */
      groups.length > 1 && (
        <ol class="film-index">
          {groups.map((group) => (
            <li>
              <a href={`#year-${group.year}`}>{group.year}</a>
              <span class="film-index-count">{group.films.length}</span>
            </li>
          ))}
        </ol>
      )
    }
  </header>

  {
    films.length > 0 && (
      <div class="film-controls">
        {
          genres.length > 0 && (
            <p class="film-control">
              <label for="film-genre-select">Genre</label>
              <select id="film-genre-select" data-film-genre-select>
                <option value="">All genres</option>
                {genres.map((genre) => (
                  <option value={genre}>{genre}</option>
                ))}
              </select>
            </p>
          )
        }
        {
          groups.length > 1 && (
            <p class="film-control" data-film-year-control>
              <label for="film-year-select">Year</label>
              <select id="film-year-select" data-film-year-select>
                {groups.map((group) => (
                  <option value={`#year-${group.year}`}>
                    {group.year} ({group.films.length})
                  </option>
                ))}
              </select>
            </p>
          )
        }
        <button type="button" class="film-shuffle-button" data-film-shuffle>
          Shuffle
        </button>
        {/* Hidden until pick-view.ts runs: without JavaScript it couldn't
            do anything. A button, so it's a real control to a keyboard or
            screen reader; inside a form only so the markup says "action". */}
        <form class="film-control film-pick" data-film-pick hidden>
          <button type="submit" class="film-shuffle-button">
            Pick for me
          </button>
        </form>
        <p class="film-pick-status" data-film-pick-status role="status" aria-live="polite" />
      </div>
    )
  }


  {
    groups.map((group, groupIndex) => (
      <section class="film-year-group" id={`year-${group.year}`}>
        <div class="film-year-heading">
          <h2>{group.year}</h2>
          <p class="film-year-count">
            {group.films.length} film{group.films.length === 1 ? '' : 's'} seen
          </p>
        </div>
        <ul class="film-grid">
          {group.films.map((film, filmIndex) => {
            // The first row is on screen at load: fetch it now, the very
            // first poster first (it's the page's largest paint). Every
            // later poster waits until it's scrolled near.
            const firstRow = groupIndex === 0 && filmIndex < 5;
            const cropped = film.posterFocal !== null;
            const style = cropped
              ? `--focal-x:${String(film.posterFocal?.x)}%;--focal-y:${String(film.posterFocal?.y)}%;--focal-zoom:${String(film.posterFocal?.zoom)};`
              : undefined;
            // Its place in the year's viewing order: the list is newest first,
            // so the year's first film seen is the last card, № 1.
            const number = group.films.length - filmIndex;
            const seenDay = seen(film.ratedOn);
            const credits = [film.director, film.year > 0 ? String(film.year) : null]
              .filter((part): part is string => Boolean(part))
              .join(' · ');
            return (
              <li
                class="film-card"
                id={`film-${filmId(film)}`}
                data-genres={film.genres.join('|')}
              >
                <div class="film-poster-frame">
                  {film.posterPath ? (
                    <img
                      class="film-poster"
                      data-cropped={cropped ? 'true' : undefined}
                      style={style}
                      src={`${config.posterBaseUrl}${film.posterPath}`}
                      alt=""
                      loading={firstRow ? 'eager' : 'lazy'}
                      fetchpriority={groupIndex === 0 && filmIndex === 0 ? 'high' : undefined}
                      width="500"
                      height="750"
                    />
                  ) : (
                    <div class="film-poster-placeholder" aria-hidden="true">
                      No poster available
                    </div>
                  )}
                </div>
                <div class="film-card-body">
                  <p class="film-catalogue">
                    № {number}
                    {seenDay && <span> · {seenDay}</span>}
                  </p>
                  <h3 class="film-title">
                    <a href={film.letterboxdUrl} target="_blank" rel="noopener noreferrer">
                      {film.title}
                    </a>
                  </h3>
                  {(credits.length > 0 || film.runtimeMinutes) && (
                    <p class="film-meta">
                      {credits}
                      {film.runtimeMinutes && (
                        <span class="film-runtime">
                          {credits.length > 0 && ' · '}
                          {formatRuntime(film.runtimeMinutes)}
                        </span>
                      )}
                    </p>
                  )}
                  {film.overview && <p class="film-overview">{excerpt(film.overview, 220)}</p>}
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }


  {
    firstSeen && (
      <p class="film-colophon">
        {films.length} films, the first seen {longDate.format(new Date(`${firstSeen}T00:00:00Z`))}.
      </p>
    )
  }

  {
    hasPosters && (
      <p class="film-attribution">
        Poster art and plot summaries via{' '}
        <a href="https://www.themoviedb.org/" target="_blank" rel="noopener noreferrer">
          TMDB
        </a>
        . {config.tmdbAttribution}
      </p>
    )
  }

  {
    films.length > 0 && (
      <script>
        import { rearrange } from '../../films/motion.ts';

        // Pure convenience: every year is already reachable by scrolling and
        // by its own real #year-<year> anchor (a direct link to one still
        // works with this script absent). The select just saves the scroll.
        const yearSelect = document.querySelector<HTMLSelectElement>('[data-film-year-select]');
        if (yearSelect) {
          if (
            location.hash &&
            [...yearSelect.options].some((option) => option.value === location.hash)
          ) {
            yearSelect.value = location.hash;
          }
          yearSelect.addEventListener('change', () => {
            const target = document.querySelector(yearSelect.value);
            target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.replaceState(null, '', yearSelect.value);
          });
        }

        // Genre is a client-side filter, not a route — there is no
        // per-genre page the way photography has one per tag, so this
        // just hides non-matching cards (and any year section left with
        // none showing) rather than navigating anywhere. Without
        // JavaScript every film stays visible, same as the year select
        // doing nothing without it: a smaller experience, not a broken one.
        const genreSelect = document.querySelector<HTMLSelectElement>('[data-film-genre-select]');
        const cards = Array.from(document.querySelectorAll<HTMLElement>('.film-card'));
        const yearGroups = Array.from(document.querySelectorAll<HTMLElement>('.film-year-group'));

        const applyGenreFilter = (): void => {
          const genre = genreSelect?.value ?? '';
          for (const card of cards) {
            const cardGenres = (card.dataset['genres'] ?? '').split('|');
            card.hidden = genre !== '' && !cardGenres.includes(genre);
          }
          for (const group of yearGroups) {
            // Also hides a year emptied by Shuffle, which moves every card out.
            const cardsInGroup = Array.from(group.querySelectorAll<HTMLElement>('.film-card'));
            group.hidden = cardsInGroup.every((card) => card.hidden);
          }
        };
        genreSelect?.addEventListener('change', applyGenreFilter);

        // Shuffle deals the whole library into one grid in random order —
        // the year sections step aside (and the Year jump with them, since
        // there are no years to jump to), the genre filter keeps applying on
        // top, and every press deals again. A reload returns to by-year.
        const shuffleButton = document.querySelector<HTMLButtonElement>('[data-film-shuffle]');
        const firstGroup = yearGroups[0];
        if (shuffleButton && firstGroup) {
          const shuffled = document.createElement('section');
          shuffled.className = 'film-shuffled';
          shuffled.hidden = true;
          const grid = document.createElement('ul');
          grid.className = 'film-grid';
          shuffled.appendChild(grid);
          firstGroup.before(shuffled);

          shuffleButton.addEventListener('click', () => {
            const order = [...cards];
            for (let i = order.length - 1; i > 0; i -= 1) {
              const j = Math.floor(Math.random() * (i + 1));
              [order[i], order[j]] = [order[j] as HTMLElement, order[i] as HTMLElement];
            }
            // The deal itself is instant, scroll included (a smooth scroll
            // under moving posters reads as two motions fighting); the
            // posters that end up on screen then glide or settle into
            // place (motion.ts).
            rearrange(cards, () => {
              for (const card of order) grid.appendChild(card);
              shuffled.hidden = false;
              const yearControl = document.querySelector<HTMLElement>('[data-film-year-control]');
              if (yearControl) yearControl.hidden = true;
              applyGenreFilter();
              const top = shuffled.getBoundingClientRect().top;
              if (top < 0 || top > window.innerHeight * 0.5) {
                window.scrollTo({ top: window.scrollY + top, behavior: 'instant' });
              }
            });
          });
        }
      </script>
    )
  }
  {
    films.length > 0 && (
      <script>
        import '../../films/pick-view.ts';
      </script>
    )
  }
</Base>
