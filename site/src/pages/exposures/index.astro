---
import GridLayout from '../../photography/GridLayout.astro';
import Lightbox from '../../photography/Lightbox.astro';
import Photo from '../../photography/Photo.astro';
import Base from '../../layouts/Base.astro';
import {
  citiesOf,
  loadArchive,
  selectedWork,
  weightOf,
} from '../../photography/archive.ts';
import { GRID_SIZES } from '../../photography/image.ts';
import { photography } from '../../photography/config.ts';
import { filmStockName } from '../../photography/film-stocks.ts';

const archive = loadArchive();
const photos = selectedWork(archive);
// Only stocks that actually appear in Selected Work — a choice that would
// filter down to nothing is just a dead end.
const filmStocks = [
  ...new Set(photos.map((entry) => entry.roll.filmStock).filter((stock) => stock.length > 0)),
].sort((a, b) => filmStockName(a).localeCompare(filmStockName(b)));
// Same rule for places: only cities some Selected Work photo is tagged with,
// in albums/cities.yaml's order.
const locations = archive.cities.filter((city) =>
  photos.some((entry) => entry.tags.includes(city.tag)),
);
---

<Base
  title={photography.title}
  description="A curated sequence of photographs."
>
  <header class="album-header">
    <h1>{photography.title}</h1>
  </header>

  {
    photos.length === 0 ? (
      <p class="lede">
        Nothing is published yet — give a photo a heart in the editor (its
        batch's photos.yaml <code>rating</code>) to have it appear here.
      </p>
    ) : (
      <Fragment>
        <div class="selected-toolbar" data-selected-toolbar hidden>
          {locations.length > 0 && (
            <label class="selected-filter">
              <select data-location-filter aria-label="Location">
                <option value="">Select location</option>
                {locations.map((city) => (
                  <option value={city.tag}>{city.name}</option>
                ))}
              </select>
            </label>
          )}
          <label class="selected-filter">
            <select data-film-filter aria-label="Film stock">
              {/* Uppercase in the text itself, not by CSS: a native option
                  list (a phone's especially) ignores text-transform, and the
                  closed select and its open list should read the same.
                  Values stay the roll's own identifiers (rolls.yaml). */}
              <option value="">SELECT FILM STOCK</option>
              {filmStocks.map((stock) => (
                <option value={stock}>{filmStockName(stock).toUpperCase()}</option>
              ))}
            </select>
          </label>
          <button type="button" class="selected-shuffle" data-shuffle>
            Shuffle
          </button>
          <a class="selected-shuffle" href="/exposures/exhibition/" data-exhibit>
            Exhibition
          </a>
        </div>

        <div class="grid" data-grid>
          {photos.map((entry, index) => (
            <figure
              data-photo-id={entry.photo.sourceId}
              data-w={weightOf(entry.rating)}
              data-film-stock={entry.roll.filmStock}
              data-cities={citiesOf(archive, entry)
                .map((city) => city.tag)
                .join(' ')}
            >
              <Photo
                entry={entry}
                sizes={GRID_SIZES}
                maxWidth={1280}
              />
            </figure>
          ))}
        </div>
        <GridLayout deal />

        <Lightbox photos={photos} />

        <script>
          import '../../photography/selected-view.ts';
          import '../../photography/grid-save.ts';
        </script>
      </Fragment>
    )
  }
</Base>
