---
import Lightbox from '../../../photography/Lightbox.astro';
import Photo from '../../../photography/Photo.astro';
import Base from '../../../layouts/Base.astro';
import PhotographyNav from '../../../photography/PhotographyNav.astro';
import { batchAddedDates, byDateAdded, loadArchive } from '../../../photography/archive.ts';

// Deliberately unlinked — not in PhotographyNav, not in collections.ts's
// urls() (so sitemap.xml.ts never lists it either), the same "secret by
// omission" treatment /exposures/archive/ already gets. Every single
// photograph in the collection, flattened, not one cover per tag the way
// that page is — this is the real "everything" view, for one visitor who
// already knows the URL.
const archive = loadArchive();

// Newest batch first (see batchAddedDates — when each batch entered the
// repository), each batch's own photos keeping their roll/frame order.
const photos = byDateAdded(archive.photos, batchAddedDates(), 'newest-first');
---

<Base title="Archives — Exposures" description="Every photograph in the collection.">
  <PhotographyNav current="archive" />
  <header class="album-header">
    <h1>Archives</h1>
    <p class="lede">
      {photos.length} photograph{photos.length === 1 ? '' : 's'}, every batch.
    </p>
  </header>

  <div class="grid" data-grid>
    {
      photos.map((entry, index) => (
        <figure data-photo-id={entry.photo.sourceId}>
          <Photo
            entry={entry}
            sizes="(min-width: 64rem) 11vw, (min-width: 40rem) 17vw, 45vw"
            priority={index === 0}
            maxWidth={1280}
          />
        </figure>
      ))
    }
  </div>

  <Lightbox photos={photos} />

  <script>
    import '../../../photography/lightbox.ts';
    import '../../../photography/masonry.ts';
  </script>
</Base>
