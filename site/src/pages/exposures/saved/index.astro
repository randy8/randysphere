---
import Lightbox from '../../../photography/Lightbox.astro';
import Photo from '../../../photography/Photo.astro';
import Base from '../../../layouts/Base.astro';
import { loadArchive } from '../../../photography/archive.ts';
import { GRID_SIZES } from '../../../photography/image.ts';
import { photography } from '../../../photography/config.ts';

const archive = loadArchive();

// The server has no idea what's saved (that's localStorage, entirely
// client-side) — this page renders the whole archive, as a grid and as
// lightbox data, and saved-view.ts prunes both down to the saved subset before a
// visitor ever sees them. Archive order throughout: "Saved" is a filter
// over the archive, not a separately-ordered list.
---

<Base
  title={`Saved — ${photography.title}`}
  description="Photographs saved to revisit later. Stored only in this browser."
>
  <header class="album-header saved-header">
    <h1>Saved</h1>
    <p class="saved-meta">
      <span class="saved-summary" data-saved-summary aria-live="polite" hidden></span>
      <span class="saved-actions" data-saved-actions hidden>
        {/* Browsing: share everything, start selecting, or clear. */}
        <span class="saved-action-group" data-mode="browse">
          <button type="button" class="saved-share" data-share-all>Share all</button>
          <span class="saved-actions-sep" aria-hidden="true">·</span>
          <button type="button" class="saved-clear" data-select-start>Select</button>
          <span class="saved-actions-sep" aria-hidden="true">·</span>
          <button type="button" class="saved-clear" data-clear-saved>Clear</button>
        </span>
        {/* Selecting: tap photographs to tick them, then share just those. */}
        <span class="saved-action-group" data-mode="select" hidden>
          <button type="button" class="saved-clear" data-select-all>Select all</button>
          <span class="saved-actions-sep" aria-hidden="true">·</span>
          <button type="button" class="saved-share" data-share-selected disabled>Share selected</button>
          <span class="saved-actions-sep" aria-hidden="true">·</span>
          <button type="button" class="saved-clear" data-select-done>Done</button>
        </span>
        {/* Clearing is the one destructive action here, so it asks first. */}
        <span class="saved-action-group" data-mode="confirm-clear" hidden>
          <span data-clear-question>Clear everything?</span>
          <button type="button" class="saved-share" data-clear-yes>Clear</button>
          <span class="saved-actions-sep" aria-hidden="true">·</span>
          <button type="button" class="saved-clear" data-clear-no>Keep</button>
        </span>
      </span>
    </p>
  </header>

  {/* The outcome of sharing, made explicit: the link itself, copyable by
      hand if the clipboard is unavailable, plus Copy / Share… / Open. */}
  <section class="share-panel" data-share-panel aria-labelledby="share-panel-title" hidden>
    <p class="share-panel-title" id="share-panel-title" data-share-title></p>
    <div class="share-panel-row">
      <input
        class="share-panel-url"
        type="text"
        readonly
        aria-label="Share link"
        data-share-url
      />
      <button type="button" class="share-panel-button" data-share-copy>Copy</button>
      <button type="button" class="share-panel-button" data-share-native hidden>Share…</button>
      <a class="share-panel-button" data-share-open target="_blank" rel="noopener">Open</a>
    </div>
    <p class="share-panel-note" data-share-status aria-live="polite">
      Anyone with this link sees exactly these photographs. Your Saved list isn't changed.
    </p>
    <button type="button" class="share-panel-close" data-share-close aria-label="Close share link">
      <span aria-hidden="true">×</span>
    </button>
  </section>

  <p class="saved-empty" data-saved-empty>
    Nothing saved yet — saved photographs are stored only in this browser.
  </p>
  <noscript>
    <p class="saved-empty">Saving photographs requires JavaScript.</p>
  </noscript>

  <ul class="grid saved-grid" data-saved-grid>
    {
      archive.photos.map((entry, index) => (
        <li data-photo-id={entry.photo.sourceId}>
          <Photo
            entry={entry}
            sizes={GRID_SIZES}
            priority={index === 0}
            maxWidth={960}
          />
          <button type="button" class="saved-grid-remove" data-remove-saved aria-label="Remove from Saved">
            <span aria-hidden="true">×</span>
          </button>
          <span class="saved-grid-check" aria-hidden="true"></span>
        </li>
      ))
    }
  </ul>

  <Lightbox photos={archive.photos} photoMaxWidth={1920} />

  {
    /* saved-view.ts prunes the grid and the lightbox down to the saved
       subset — it has to run, and finish, before lightbox.ts reads that
       same markup to build its own items/ids. Both are plain type="module"
       scripts, which execute in document order (the same ordering trick
       exposures/index.astro's own inline shuffle script already relies on,
       just ahead of its lightbox.ts import too), so listing this one first
       is what makes that guarantee hold. */
  }
  <script>
    import '../../../photography/saved-view.ts';
  </script>
  <script>
    import '../../../photography/lightbox.ts';
    import '../../../photography/masonry.ts';
    import '../../../photography/shuffle-on-load.ts';
  </script>
</Base>
