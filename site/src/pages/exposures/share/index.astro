---
import GridLayout from '../../../photography/GridLayout.astro';
import Lightbox from '../../../photography/Lightbox.astro';
import Photo from '../../../photography/Photo.astro';
import Base from '../../../layouts/Base.astro';
import { loadArchive, weightOf } from '../../../photography/archive.ts';
import { GRID_SIZES } from '../../../photography/image.ts';
import { photography } from '../../../photography/config.ts';

const archive = loadArchive();

// A shared link names its own photographs entirely in the URL fragment
// (share-code.ts, decoded by share-view.ts) — the server can't read that,
// so, same trick as /exposures/saved/, this renders the whole archive
// and lets client-side JS prune the grid (and the lightbox's order) down to
// just the shared subset, in the shared order (not archive order — a
// shared link is exactly the sequence its sender curated).
---

<Base
  title={`Shared — ${photography.title}`}
  description="A shared selection of photographs."
>
  <header class="album-header saved-header">
    <h1>Shared photographs</h1>
    <p class="saved-meta">
      <span class="saved-summary" data-share-summary hidden></span>
    </p>
  </header>

  <p class="saved-empty" data-share-missing hidden></p>
  <p class="saved-empty" data-share-empty>
    This link doesn't point to any photographs — it may be incomplete, or
    they're no longer in the archive. <a href="/exposures/">Browse Exposures</a>.
  </p>
  <noscript>
    <p class="saved-empty">Viewing a shared selection requires JavaScript.</p>
  </noscript>

  <div class="selected-toolbar" data-exhibit-bar hidden>
    <a class="selected-shuffle" href="/exposures/gallery/" data-exhibit>Gallery</a>
  </div>

  <ul class="grid saved-grid" data-share-grid>
    {
      archive.photos.map((entry) => (
        <li data-photo-id={entry.photo.sourceId} data-w={weightOf(entry.rating)}>
          <Photo entry={entry} sizes={GRID_SIZES} maxWidth={960} />
        </li>
      ))
    }
  </ul>
  <GridLayout />

  <p class="next-album share-more" data-share-more hidden>
    <a href="/exposures/">More photographs in Exposures →</a>
  </p>

  <Lightbox photos={archive.photos} photoMaxWidth={1920} />

  {
    /* share-view.ts prunes and reorders both the grid and the lightbox
       before lightbox.ts reads either — same document-order guarantee
       saved-view.ts already relies on ahead of its own lightbox.ts import. */
  }
  <script>
    import '../../../photography/share-view.ts';
  </script>
  <script>
    import '../../../photography/lightbox.ts';
    import '../../../photography/shuffle-on-load.ts';
  </script>
</Base>
