---
import GridLayout from '../../photography/GridLayout.astro';
import Lightbox from '../../photography/Lightbox.astro';
import Photo from '../../photography/Photo.astro';
import Base from '../../layouts/Base.astro';
import { allTags, loadArchive, viewForTag } from '../../photography/archive.ts';
import { GRID_SIZES } from '../../photography/image.ts';
import { formatDate } from '../../photography/date.ts';
import type { View } from '../../photography/archive.ts';
import { filmStockName } from '../../photography/film-stocks.ts';

export function getStaticPaths() {
  const archive = loadArchive();
  const tags = allTags(archive);
  // Same order /exposures/archive/ lists albums in (allTags is
  // alphabetical) — "next" reuses the sequence a visitor already sees
  // there rather than inventing a second ordering. The last tag gets no
  // next view, same as a book's last chapter.
  return tags.map((tag, index) => {
    const nextTag = tags[index + 1];
    return {
      params: { tag },
      props: {
        view: viewForTag(archive, tag),
        nextView: nextTag !== undefined ? viewForTag(archive, nextTag) : null,
      },
    };
  });
}

interface Props {
  view: View;
  nextView: View | null;
}

const { view, nextView } = Astro.props;
const next = nextView
  ? { tag: nextView.tag, title: nextView.title, date: nextView.date, count: nextView.photos.length }
  : null;
---

<Base title={view.title} description={view.title}>
  <header class="album-header">
    {
      view.roll?.filmStock && (
        <p class="eyebrow">
          <a href={`/exposures/film/${view.roll.filmStock}/`}>{filmStockName(view.roll.filmStock)}</a>
          {view.date && (
            <Fragment>
              {' · '}
              <time class="dateline" datetime={view.date}>
                {formatDate(view.date)}
              </time>
            </Fragment>
          )}
        </p>
      )
    }
    {
      !view.roll?.filmStock && view.date && (
        <p class="eyebrow">
          <time class="dateline" datetime={view.date}>
            {formatDate(view.date)}
          </time>
        </p>
      )
    }
    <h1>{view.title}</h1>
  </header>

  <div class="selected-toolbar" data-exhibit-bar hidden>
    <a class="selected-shuffle" href={`/exposures/exhibition/?tag=${encodeURIComponent(view.tag)}`}>Exhibition</a>
  </div>

  <div class="grid" data-grid>
    {
      view.photos.map((entry, index) => (
        <figure data-photo-id={entry.photo.sourceId}>
          <Photo
            entry={entry}
            sizes={GRID_SIZES}
            maxWidth={1280}
          />
          <span class="frame-mark" aria-hidden="true">
            {String(entry.frame).padStart(2, '0')}
          </span>
        </figure>
      ))
    }
  </div>
  <GridLayout deal />

  {
    next && (
      <p class="next-album">
        <a href={`/exposures/${next.tag}/`}>Next: {next.title} →</a>
      </p>
    )
  }

  <Lightbox photos={view.photos} />

  <script>
    import '../../photography/lightbox.ts';
    import '../../photography/shuffle-on-load.ts';
    import '../../photography/grid-save.ts';
    import '../../photography/exhibit-link.ts';
  </script>
</Base>
