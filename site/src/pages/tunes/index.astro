---
import '../../music/music.css';
import Base from '../../layouts/Base.astro';
import { loadTracks, youtubeThumbnail } from '../../music/music.ts';
import { music as config } from '../../music/config.ts';

const tracks = loadTracks();
---

<Base title={config.title} description={config.description || undefined}>
  <Fragment>
    <header class="album-header">
      <h1>{config.title}</h1>
      {config.description && <p class="lede">{config.description}</p>}
    </header>

    {
      tracks.length === 0 ? (
        <p class="lede">
          Nothing here yet — add a YouTube or Spotify link to <code>music/tracks.yaml</code> to have
          it appear here.
        </p>
      ) : (
        <ul class="tune-grid">
          {tracks.map((track, index) => (
            <li class="tune">
              {/* A plain link to the song on YouTube/Spotify — what a
                  visitor without JavaScript gets. tunes.ts opens it in
                  the player dialog below instead. */}
              <a
                class="tune-link"
                href={track.url}
                aria-haspopup="dialog"
                data-tune-open
                data-platform={track.platform}
                data-embed={track.embedUrl}
                data-title={track.title}
                data-artist={track.artist}
              >
                <span class="tune-still">
                  {track.videoId !== null ? (
                    <img
                      src={youtubeThumbnail(track.videoId)}
                      alt=""
                      width="1280"
                      height="720"
                      loading={index < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                      data-tune-thumb
                      data-video-id={track.videoId}
                    />
                  ) : (
                    <span class="tune-still-blank">Spotify</span>
                  )}
                  <span class="tune-play" aria-hidden="true" />
                </span>
                <div class="tune-caption">
                  <h2 class="tune-title">{track.title}</h2>
                  {track.artist && <p class="tune-artist">{track.artist}</p>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </Fragment>

  {
    /* The screening room: one for the whole page, filled on open and
       emptied on close (tunes.ts) — no iframe exists until a visitor asks
       for one. tunes.ts moves it to <body> so the page behind it can be
       made inert while it's open. */
  }
  <div
    class="tune-viewer"
    data-tune-viewer
    role="dialog"
    aria-modal="true"
    aria-labelledby="tune-viewer-title"
    hidden
  >
    <div class="tune-viewer-ambient" aria-hidden="true"></div>
    <div class="tune-viewer-bar">
      <button type="button" class="tune-viewer-back" data-tune-close aria-label="Back to Tunes">
        <span aria-hidden="true">←</span> Tunes
      </button>
      <a class="tune-viewer-external" data-tune-external target="_blank" rel="noopener noreferrer"
      ></a>
    </div>
    <div class="tune-viewer-stage">
      <div class="tune-viewer-column">
        <div class="tune-screen" data-tune-screen>
          <img class="tune-screen-poster" data-tune-poster alt="" />
          {/* oEmbed (tunes.ts) says when a video's owner has turned
              embedding off; the iframe alone can't tell this page. */}
          <div class="tune-screen-blocked" data-tune-blocked hidden>
            <p>This one plays only on YouTube.</p>
            <a data-tune-blocked-link target="_blank" rel="noopener noreferrer"
              >Watch on YouTube ↗</a
            >
          </div>
        </div>
        <div class="tune-viewer-caption">
          <div class="tune-viewer-meta" data-tune-meta aria-live="polite">
            <h2 class="tune-viewer-title" id="tune-viewer-title" data-tune-title></h2>
            <p class="tune-viewer-artist" data-tune-artist></p>
          </div>
          <div class="tune-viewer-steps">
            <button
              type="button"
              class="tune-viewer-step"
              data-tune-step="-1"
              aria-label="Previous song"
            >
              <span aria-hidden="true">←</span>
            </button>
            <button type="button" class="tune-viewer-step" data-tune-step="1" aria-label="Next song">
              <span aria-hidden="true">→</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import '../../music/tunes.ts';
  </script>
</Base>
