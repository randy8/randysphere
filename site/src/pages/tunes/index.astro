---
import '../../music/music.css';
import Base from '../../layouts/Base.astro';
import { loadTracks, youtubeThumbnail } from '../../music/music.ts';
import { music as config } from '../../music/config.ts';

const tracks = loadTracks();
---

<Base title={config.title} description={config.description || undefined}>
  <Fragment>
    <header class="album-header">
      <h1>{config.title}</h1>
      {config.description && <p class="lede">{config.description}</p>}
      {
        tracks.length > 0 && (
          <div class="tune-radio">
            {/* Revealed by tunes.ts: it does nothing without JavaScript. */}
            <button type="button" class="tune-radio-play" data-tune-play-all hidden>
              <span aria-hidden="true">▶</span> Play all
            </button>
            <p class="tune-radio-note">
              The songs play through YouTube, which may put ads between them. To skip those on an
              iPhone or iPad, install{' '}
              <a href="https://apps.apple.com/app/id1018301773" rel="noopener noreferrer">
                AdBlock Pro
              </a>{' '}
              (free) from the App Store, turn it on in Settings under Safari → Extensions, then
              reload this page.
            </p>
          </div>
        )
      }
    </header>

    {
      tracks.length === 0 ? (
        <p class="lede">
          Nothing here yet — add a YouTube or Spotify link to <code>music/tracks.yaml</code> to have
          it appear here.
        </p>
      ) : (
        <ul class="tune-grid">
          {tracks.map((track, index) => (
            <li class="tune">
              {/* A plain link to the song on YouTube/Spotify — what a
                  visitor without JavaScript gets. tunes.ts opens it in
                  the player dialog below instead. */}
              <a
                class="tune-link"
                href={track.url}
                aria-haspopup="dialog"
                data-tune-open
                data-platform={track.platform}
                data-embed={track.embedUrl}
                data-title={track.title}
                data-artist={track.artist}
              >
                <span class="tune-still">
                  {track.videoId !== null ? (
                    <img
                      src={youtubeThumbnail(track.videoId)}
                      alt=""
                      width="1280"
                      height="720"
                      loading={index < 2 ? 'eager' : 'lazy'}
                      fetchpriority={index === 0 ? 'high' : undefined}
                      decoding="async"
                      data-tune-thumb
                      data-video-id={track.videoId}
                    />
                  ) : (
                    <span class="tune-still-blank">Spotify</span>
                  )}
                  <span class="tune-play" aria-hidden="true" />
                </span>
                <div class="tune-caption">
                  <h2 class="tune-title">{track.title}</h2>
                  {track.artist && <p class="tune-artist">{track.artist}</p>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      /* Shuffled like every photo page (grid-layout.js's deal): inline,
         right after the list, so the first paint is already in the new
         order and tunes.ts (a module, later) steps through it as shown.
         A refresh deals again; Back or a link finds the order it left,
         seeded per session. Without JavaScript: tracks.yaml's order. */
    }
    <script is:inline>
      (() => {
        const list = document.querySelector('.tune-grid');
        if (!list) return;
        const key = `deal:${location.pathname}`;
        const navigation = performance.getEntriesByType('navigation')[0];
        const reload = navigation !== undefined && navigation.type === 'reload';
        let seed = 0;
        try {
          if (!reload) seed = Number(sessionStorage.getItem(key));
        } catch {
          seed = 0;
        }
        if (!Number.isInteger(seed) || seed <= 0) {
          seed = Math.floor(Math.random() * 4294967295) + 1;
          try {
            sessionStorage.setItem(key, String(seed));
          } catch {
            // Storage off: this visit's order just isn't kept.
          }
        }
        // mulberry32, as grid-layout.js: the same order from the same seed.
        let state = seed >>> 0;
        const random = () => {
          state = (state + 0x6d2b79f5) >>> 0;
          let t = state;
          t = Math.imul(t ^ (t >>> 15), t | 1);
          t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
        const keyed = Array.from(list.children, (tune) => ({ tune, key: random() }));
        keyed.sort((a, b) => b.key - a.key);
        list.append(...keyed.map(({ tune }) => tune));
        // The stills that now open the page load first, as the first two did.
        list.querySelectorAll('[data-tune-thumb]').forEach((img, index) => {
          img.loading = index < 2 ? 'eager' : 'lazy';
          if (index === 0) img.setAttribute('fetchpriority', 'high');
          else img.removeAttribute('fetchpriority');
        });
      })();
    </script>
  </Fragment>

  {
    /* The screening room: one for the whole page, filled on open and
       emptied on close (tunes.ts) — no iframe exists until a visitor asks
       for one. tunes.ts moves it to <body> so the page behind it can be
       made inert while it's open. */
  }
  <div
    class="tune-viewer"
    data-tune-viewer
    role="dialog"
    aria-modal="true"
    aria-labelledby="tune-viewer-title"
    hidden
  >
    <div class="tune-viewer-ambient" aria-hidden="true"></div>
    <div class="tune-viewer-bar">
      <button type="button" class="tune-viewer-back" data-tune-close aria-label="Back to Tunes">
        <span aria-hidden="true">←</span> Tunes
      </button>
      <div class="tune-viewer-bar-end">
        {/* The room folds into a bar along the bottom and the song plays on
            while the visitor goes anywhere on the site (tunes.ts). */}
        <button type="button" class="tune-viewer-browse" data-tune-dock>
          Browse while it plays <span aria-hidden="true">↓</span>
        </button>
        {/* Autoplay: when a song ends, the next one starts — the list as a radio. */}
        <button type="button" class="tune-viewer-autoplay" data-tune-autoplay aria-pressed="false">
          Autoplay <span class="tune-viewer-autoplay-state" data-tune-autoplay-state>off</span>
        </button>
        <a
          class="tune-viewer-external"
          data-tune-external
          target="_blank"
          rel="noopener noreferrer"></a>
      </div>
    </div>
    <div class="tune-viewer-stage">
      <div class="tune-viewer-column">
        <div class="tune-screen" data-tune-screen>
          <img class="tune-screen-poster" data-tune-poster alt="" />
          {/* oEmbed (tunes.ts) says when a video's owner has turned
              embedding off; the iframe alone can't tell this page. */}
          <div class="tune-screen-blocked" data-tune-blocked hidden>
            <p>This one plays only on YouTube.</p>
            <a data-tune-blocked-link target="_blank" rel="noopener noreferrer"
              >Watch on YouTube ↗</a
            >
          </div>
        </div>
        <div class="tune-viewer-caption">
          <div class="tune-viewer-meta" data-tune-meta aria-live="polite">
            <h2 class="tune-viewer-title" id="tune-viewer-title" data-tune-title></h2>
            <p class="tune-viewer-artist" data-tune-artist></p>
          </div>
          <div class="tune-viewer-steps">
            <button
              type="button"
              class="tune-viewer-step"
              data-tune-step="-1"
              aria-label="Previous song"
            >
              <span aria-hidden="true">←</span>
            </button>
            {/* Only in the bar: in the room, YouTube's own controls are right there. */}
            <button
              type="button"
              class="tune-viewer-step tune-viewer-pause"
              data-tune-pause
              aria-label="Pause"
            >
              <svg viewBox="0 0 14 14" aria-hidden="true" data-tune-pause-icon>
                <rect x="2.5" y="1.5" width="3" height="11" /><rect
                  x="8.5"
                  y="1.5"
                  width="3"
                  height="11"></rect>
              </svg>
              <svg viewBox="0 0 14 14" aria-hidden="true" data-tune-play-icon hidden>
                <path d="M3 1.5 12.5 7 3 12.5z"></path>
              </svg>
            </button>
            <button type="button" class="tune-viewer-step" data-tune-step="1" aria-label="Next song">
              <span aria-hidden="true">→</span>
            </button>
          </div>
          <div class="tune-viewer-steps tune-viewer-dock-end">
            <button
              type="button"
              class="tune-viewer-step"
              data-tune-expand
              aria-label="Open the player"
            >
              <span aria-hidden="true">↑</span>
            </button>
            <button type="button" class="tune-viewer-step" data-tune-stop aria-label="Stop the music">
              <span aria-hidden="true">✕</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import '../../music/tunes.ts';
  </script>
</Base>
