{
  "name": "photography",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A static photography portfolio: an Astro site and a framework-independent image pipeline.",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "dev": "pnpm --filter @photo/site dev",
    "dev:host": "pnpm --filter @photo/site dev:host",
    "build": "pnpm --filter @photo/site build",
    "preview": "node tools/serve/src/cli.ts --preview --port=4323",
    "preview:host": "pnpm --filter @photo/site preview:host",
    "ingest": "node tools/pipeline/src/cli.ts ingest",
    "publish": "node tools/pipeline/src/cli.ts publish",
    "publish:images": "node tools/pipeline/src/cli.ts publish",
    "sync": "pnpm ingest && pnpm films:posters",
    "describe": "node tools/pipeline/src/cli.ts describe",
    "films:posters": "node tools/films/fetch-posters.ts",
    "doctor": "node tools/pipeline/src/cli.ts doctor",
    "edit": "node tools/pipeline/src/cli.ts edit",
    "family": "node tools/serve/src/family/cli.ts",
    "disc": "node tools/serve/src/family/cli.ts --chat=disc",
    "serve": "node tools/serve/src/cli.ts",
    "deploy": "bash deploy/deploy.sh",
    "rollback": "bash deploy/rollback.sh",
    "status": "bash deploy/status.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tools/pipeline && tsc --noEmit -p tools/films && tsc --noEmit -p tools/serve && tsc --noEmit -p tools/qa && tsc --noEmit -p site",
    "test": "node --test 'tools/pipeline/src/**/*.test.ts' 'tools/serve/src/**/*.test.ts' 'tools/qa/src/**/*.test.ts' 'site/src/**/*.test.ts'",
    "verify": "pnpm check && pnpm --filter @photo/site exec astro build --outDir node_modules/.cache/verify-dist",
    "check": "node tools/qa/src/check.ts",
    "test:browser": "node tools/qa/src/browser-run.ts",
    "measure": "node tools/qa/src/measure.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "prettier": "^3.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
