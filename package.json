{
  "name": "photography",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A static photography portfolio: an Astro site and a framework-independent image pipeline.",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "dev": "pnpm --filter @photo/site dev",
    "dev:host": "pnpm --filter @photo/site dev:host",
    "build": "pnpm --filter @photo/site build",
    "preview": "pnpm --filter @photo/site preview",
    "preview:host": "pnpm --filter @photo/site preview:host",
    "ingest": "node tools/pipeline/src/cli.ts ingest",
    "publish": "node tools/pipeline/src/cli.ts publish",
    "publish:images": "node tools/pipeline/src/cli.ts publish",
    "publish:local": "node tools/pipeline/src/cli.ts publish --local",
    "sync": "pnpm ingest && pnpm publish:local",
    "describe": "node tools/pipeline/src/cli.ts describe",
    "doctor": "node tools/pipeline/src/cli.ts doctor",
    "edit": "node tools/pipeline/src/cli.ts edit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tools/pipeline && tsc --noEmit -p site",
    "test": "node --test 'tools/pipeline/src/**/*.test.ts' 'site/src/**/*.test.ts'",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "prettier": "^3.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
