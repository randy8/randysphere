# Copy to .env and fill in. .env is git-ignored; this file is not.
# Only needed to publish to R2. `pnpm run publish --local` needs none of it.

# Cloudflare dashboard -> R2 -> the hex string in the endpoint URL.
R2_ACCOUNT_ID=

# R2 -> Manage API Tokens -> Create, with Object Read & Write on one bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Only needed for `pnpm describe`, which drafts alt text and captions.
# `pnpm ingest` never reads this and has no network dependency.
ANTHROPIC_API_KEY=

# Only needed for `pnpm films:posters`, which fetches poster art/plot/
# runtime/director for films/ from TMDB. Free key: themoviedb.org/settings/api
# (use the "API Read Access Token", not the shorter v3 API key).
TMDB_READ_ACCESS_TOKEN=

# Only needed for `pnpm serve`, which serves site/dist/ plus one
# password-gated route, /private, for a hand-written personal notebook
# (private/notes.yaml) that is never part of the public build.
#
# PRIVATE_SITE_PASSWORD is whatever you want to type in to unlock /private.
# PRIVATE_SESSION_SECRET signs the login session — generate a random one
# with: openssl rand -hex 32. Changing it instantly logs everyone out.
PRIVATE_SITE_PASSWORD=
PRIVATE_SESSION_SECRET=
