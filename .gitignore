node_modules/

dist/
.astro/
.wrangler/

# Your master photographs. They stay on this machine and in your own backups,
# and nothing in this repository ever uploads them. The README inside is
# tracked so the directory arrives with an explanation in it.
/originals/*
!/originals/README.md

# Encoded derivatives. Rebuildable from originals/ at any time, so there is no
# reason to carry them in git history forever. Note that this ignores only the
# encoded images: the manifests under generated/albums/ are tracked, because
# they are the contract between the pipeline and the site.
/generated/derivatives/

# Derivatives written by `pnpm run publish --local`. Rebuildable, and large.
/site/public/p/

# Cache of AI-generated descriptions, keyed by sourceId. Rebuildable by running
# `pnpm describe` again — at the cost of calling the provider again, which is
# the entire reason it's cached. The contract is albums/*/photos.yaml, which is
# committed; this is bookkeeping so a repeat run doesn't re-analyse a photo it
# already has a description for.
/generated/descriptions.json

# Credentials for Cloudflare R2 live here.
.env
.env.*
!.env.example

.DS_Store
Thumbs.db
*.log

# Scan deliveries from the lab, downloaded before being unpacked into
# originals/ by hand. Gigabytes each; never something to commit.
/*.zip

# Filebrowser's own state (its user database holds login hashes). The compose
# file next to it is fine to keep; this is not.
/filebrowser/database/

# The private notebook itself: served only behind /private's password, and
# kept out of this public repository from 2026-10-25. It was committed once
# before that (67c3081), so that version remains in history.
/private/notes.yaml

# Images referenced by private/notes.yaml — served only behind /private's
# password, never committed (same as notes.yaml itself).
/private/photos/

# Cache of each original's SHA-256 by size+mtime, so an ingest with nothing
# new skips reading every original (see tools/pipeline/src/source-hashes.ts).
/generated/source-hashes.json

# What production serves (site/release), the next release being built
# beside it, and the one it replaced, kept for `pnpm rollback`. Only
# `pnpm deploy` writes these (deploy/deploy.sh).
/site/release/
/site/release.next/
/site/release.prev/
/site/dist.next/
/site/dist.prev/

# Browser-test failures: screenshots, traces, reports (tools/qa).
/tools/qa/test-results/

# /system's data: deploy records, watchdog checks, measurements, written by
# jobs on this machine (tools/qa/src/status-store.ts). Machine-local state.
/status/

# /infra's list of services on this machine (tools/serve, tailnet only):
# hostnames and ports stay off GitHub.
/infra/
